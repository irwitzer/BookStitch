<Window x:Class="BookStitch.Dialog.DiscProjectSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:controls="clr-namespace:BookStitch.Controls"
        xmlns:services="clr-namespace:BookStitch.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{services:LocalizedText Key=UiProjektVorbereiten}"
        Icon="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-OpenBook.ico"
        Width="1120"
        Height="680"
        MinWidth="1130"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        KeyboardNavigation.TabNavigation="Cycle"
        Style="{StaticResource LargeResizableWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStitch;component/Themes/ConceptDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

<Style x:Key="DialogLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
            </Style>

            <Style x:Key="DialogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppearanceCompactTextBoxStyle}">
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppearanceCompactComboBoxStyle}">
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <controls:LargeResizableWindowHeader Grid.Row="0"
                                             Padding="22,0,8,0"
                                             CloseRequested="CloseButton_Click">
            <controls:LargeResizableWindowHeader.TitleContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"
                               VerticalAlignment="Center"/>
                    <Button Width="34" Margin="8,0,0,0"
                            Style="{StaticResource DeveloperToolsButtonStyle}"
                            Command="{x:Static services:DeveloperToolsCommands.OpenDeveloperToolsWindow}"
                            AutomationProperties.Name="{services:LocalizedText Key=AutomationOpenDeveloperTools}"
                            IsTabStop="False"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.TitleContent>
            <controls:LargeResizableWindowHeader.HeaderActions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MetadataButton"
                            Content="{services:LocalizedText Key=UiMetadaten}"
                            Margin="0,0,6,0"
                            Style="{StaticResource PrimaryCompactButtonStyle}"
                            Click="MetadataButton_Click"/>
                    <Button Width="42" Margin="0,0,4,0" FontSize="24"
                            Style="{StaticResource GlobalSettingsButtonStyle}"
                            IsTabStop="False"
                            Click="SettingsButton_Click"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.HeaderActions>
        </controls:LargeResizableWindowHeader>

        <Grid x:Name="SetupNavigationOverlay"
              Grid.Row="0"
              Margin="22,0,8,2"
              Panel.ZIndex="4"
              VerticalAlignment="Bottom"
              IsHitTestVisible="True"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PreviousSetupPageButton"
                    Grid.Column="0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource IconButtonStyle}"
                    IsTabStop="False"
                    Click="PreviousSetupPageButton_Click"
                    AutomationProperties.Name="{services:LocalizedText Key=AutomationPreviousProjectPage}">
                <Viewbox Width="25" Height="25" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><RotateTransform Angle="-90"/></Viewbox.RenderTransform>
                    <Grid Width="44" Height="44">
                        <Ellipse Fill="{DynamicResource InputBackgroundBrush}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.5"/>
                        <Path Data="M 22 31 L 22 13 M 14 21 L 22 13 L 30 21" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Viewbox>
            </Button>
            <Button x:Name="NextSetupPageButton"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Style="{StaticResource IconButtonStyle}"
                    IsTabStop="False"
                    Click="NextSetupPageButton_Click"
                    AutomationProperties.Name="{services:LocalizedText Key=AutomationNextProjectPage}">
                <Viewbox Width="25" Height="25" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Viewbox.RenderTransform><RotateTransform Angle="-90"/></Viewbox.RenderTransform>
                    <Grid Width="44" Height="44">
                        <Ellipse Fill="{DynamicResource InputBackgroundBrush}" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.5"/>
                        <Path Data="M 22 13 L 22 31 M 14 23 L 22 31 L 30 23" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Viewbox>
            </Button>
        </Grid>

            <Grid x:Name="SetupPageHost" Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="SetupPage0"
                              Style="{StaticResource ConceptStableVerticalGutterScrollViewerStyle}"
                              RenderTransformOrigin="0.5,0.5">
                    <ScrollViewer.RenderTransform><TranslateTransform x:Name="SetupPage0Transform"/></ScrollViewer.RenderTransform>
                <Grid x:Name="SetupPage0ViewportRoot"
                      MinHeight="{Binding ActualHeight, ElementName=SetupPageHost}">
                    <Grid x:Name="SetupPage0LayoutGrid" Margin="22,12,8,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="SetupPage0CardsGrid" Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="SetupPage0ProjectCard"
                                Grid.Column="0"
                                Background="{DynamicResource ProjectSetupCardBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <Grid x:Name="ProjectSettingsHeaderGrid" Margin="0,0,0,20" MinHeight="210">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{services:LocalizedText Key=UiProjektEinstellungen}"
                                                   Style="{StaticResource SectionTitleStyle}"/>

                                        <Grid x:Name="ProjectSettingsBaseFieldsGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="136"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock x:Name="DiscCountLabel"
                                                       Grid.Row="0"
                                                       Text="{services:LocalizedText Key=UiAnzahlCDs}"
                                                       Style="{StaticResource DialogLabelStyle}"/>
                                            <controls:DiscCountInputControl x:Name="DiscCountPanel" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"/>


                                            <TextBlock Grid.Row="1" Text="{services:LocalizedText Key=UiParallelJobs}" Style="{StaticResource DialogLabelStyle}"/>
                                            <Grid Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ParallelJobsTextBox"
                                                         HorizontalContentAlignment="Center"
                                                         PreviewTextInput="ParallelJobsTextBox_PreviewTextInput"
                                                         PreviewMouseWheel="ParallelJobsTextBox_PreviewMouseWheel"
                                                         PreviewKeyDown="ParallelJobsTextBox_KeyDown"
                                                         Style="{StaticResource DialogTextBoxStyle}"/>
                                                <RepeatButton Grid.Column="1" Content="▲" Style="{StaticResource StepperRepeatButtonStyle}" Margin="4,0,0,10" Click="IncreaseParallelJobs_Click"/>
                                                <RepeatButton Grid.Column="2" Content="▼" Style="{StaticResource StepperRepeatButtonStyle}" Margin="4,0,0,10" Click="DecreaseParallelJobs_Click"/>
                                            </Grid>

                                            <TextBlock Grid.Row="2" Text="{services:LocalizedText Key=UiEndung}" Style="{StaticResource DialogLabelStyle}"/>
                                            <ComboBox x:Name="OutputExtensionComboBox"
                                                      Grid.Row="2"
                                                      Grid.Column="1"
                                                      Width="64"
                                                      HorizontalAlignment="Left"
                                                      SelectionChanged="OutputExtensionComboBox_SelectionChanged"
                                                      Style="{StaticResource DialogComboBoxStyle}">
                                                <ComboBoxItem Content=".m4a"/>
                                                <ComboBoxItem Content=".m4b"/>
                                            </ComboBox>

                                            <TextBlock Grid.Row="3" Text="{services:LocalizedText Key=UiExportPreset}" Style="{StaticResource DialogLabelStyle}"/>
                                            <ComboBox x:Name="PresetComboBox"
                                                      Grid.Row="3"
                                                      Grid.Column="1"
                                                      Width="150"
                                                      HorizontalAlignment="Left"
                                                      SelectionChanged="PresetComboBox_SelectionChanged"
                                                      Style="{StaticResource DialogComboBoxStyle}"/>

                                            <TextBlock Grid.Row="4" Text="{services:LocalizedText Key=UiAutoMerge}" Style="{StaticResource DialogLabelStyle}"/>
                                            <CheckBox x:Name="AutoMergeCheckBox"
                                                      Grid.Row="4"
                                                      Grid.Column="1"
                                                      Content="{services:LocalizedText Key=UiAuto}"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,10"
                                                      Style="{StaticResource SettingsToggleStyle}"
                                                      Checked="AutoMergeCheckBox_Changed"
                                                      Unchecked="AutoMergeCheckBox_Changed"/>
                                            <Grid x:Name="DriveCircleRow" Grid.Row="5" Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{services:LocalizedText Key=UiDriveCircle}" Style="{StaticResource DialogLabelStyle}"/>
                                                <CheckBox x:Name="DriveCircleCheckBox" Grid.Column="1" Content="{services:LocalizedText Key=UiDriveCircleOn}" HorizontalAlignment="Left"
                                                          AutomationProperties.Name="{services:LocalizedText Key=UiDriveCircle}"
                                                          Style="{StaticResource SettingsToggleStyle}" Margin="0,0,0,10"
                                                          Checked="DriveCircleCheckBox_Changed" Unchecked="DriveCircleCheckBox_Changed"/>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>

                                    <Border x:Name="CoverBorder"
                                            Grid.Column="1"
                                            Width="189"
                                            Height="189"
                                            Margin="14,28,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource CoverPickerBorderStyle}"
                                            MouseLeftButtonUp="CoverBorder_MouseLeftButtonUp"
                                            AllowDrop="True"
                                            DragOver="Cover_DragOver"
                                            Drop="Cover_Drop"
                                            ContextMenuOpening="CoverBorder_ContextMenuOpening">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource BookStitchContextMenuStyle}">
                                                <MenuItem Header="{services:LocalizedText Key=UiCoverEntfernen}"
                                                          Style="{StaticResource BookStitchContextMenuItemStyle}"
                                                          Click="RemoveCover_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="CoverPreviewImage"
                                                   Style="{StaticResource CoverPickerImageStyle}"/>
                                            <Border x:Name="CoverHintBorder"
                                                    Style="{StaticResource CoverPickerHintBorderStyle}">
                                                <ContentControl Style="{StaticResource CoverPickerHintContentStyle}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Border x:Name="ProjectSettingsOutputSpacer" Height="37"/>
                                <Grid x:Name="ProjectSettingsOutputGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="136"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ProjectFolderLabel"
                                               Grid.Row="0"
                                               Text="{services:LocalizedText Key=UiQuellordner}"
                                               Style="{StaticResource DialogLabelStyle}"
                                               Visibility="Collapsed"/>
                                    <Button x:Name="ProjectFolderButton"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Width="274"
                                            IsTabStop="False"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,10"
                                            HorizontalContentAlignment="Stretch"
                                            Style="{StaticResource HiddenTextButtonStyle}"
                                            Visibility="Collapsed"
                                            Click="ProjectFolderButton_Click">
                                        <TextBlock x:Name="ProjectFolderTextBlock"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Button>

                                    <TextBlock Grid.Row="1" Text="{services:LocalizedText Key=UiAusgabeordner}" Style="{StaticResource DialogLabelStyle}"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Width="274" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OutputFolderStateChipButton"
                                                Grid.Column="0"
                                                Margin="0,0,0,10"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource HiddenTextButtonStyle}"
                                                Click="ChooseOutputFolder_Click"
                                                AutomationProperties.Name="{services:LocalizedText Key=AutomationChangeOutputFolder}"
                                                SizeChanged="OutputFolderStateChip_SizeChanged">
                                            <Border x:Name="OutputFolderStateChip"
                                                    Style="{StaticResource CompactStateChipStyle}">
                                                <TextBlock x:Name="OutputFolderBadgeTextBlock"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Left"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Button>
                                        <Button x:Name="OpenOutputFolderButton"
                                                Grid.Column="1"
                                                Width="36"
                                                Margin="6,0,0,10"
                                                Style="{StaticResource AccentOpenOutputFolderButtonStyle}"
                                                Click="OpenOutputFolder_Click"
                                                AutomationProperties.Name="{services:LocalizedText Key=MainWindow.Export.OpenFolder}"/>
                                    </Grid>

                                    <TextBlock Grid.Row="2" Text="{services:LocalizedText Key=UiDateiname}" Style="{StaticResource DialogLabelStyle}"/>
                                    <ComboBox x:Name="FileNameTemplateTextBox"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              Width="274"
                                              HorizontalAlignment="Left"
                                              IsEditable="True"
                                              KeyUp="MetadataComboBox_KeyUp"
                                              LostFocus="MetadataComboBox_LostFocus"
                                              SelectionChanged="MetadataComboBox_SelectionChanged"
                                              Style="{StaticResource DialogComboBoxStyle}">
                                        <ComboBoxItem Content="{}{Autor} - {Titel}"/>
                                        <ComboBoxItem Content="{}{Titel} - {Autor}"/>
                                        <ComboBoxItem Content="{}{Titel}"/>
                                        <ComboBoxItem Content="{}{Autor} - {Sprecher} - {Titel}"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="3" Text="{services:LocalizedText Key=UiVorschau}" Style="{StaticResource DialogLabelStyle}"/>
                                    <TextBlock x:Name="PreviewTextBlock"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Foreground="{DynamicResource MainTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,10"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SetupPage0MetadataCard"
                                Grid.Column="2"
                                Background="{DynamicResource ProjectSetupCardBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{services:LocalizedText Key=UiMetadaten}" Style="{StaticResource SectionTitleStyle}"/>
                                </DockPanel>
                                <StackPanel x:Name="SetupMetadataFieldsPanel">
                                    <controls:ConceptMetadataFieldControl x:Name="SetupTitleField" PresentationMode="Minimal"/>
                                    <controls:ConceptMetadataFieldControl x:Name="SetupAlbumField" PresentationMode="Minimal"/>
                                    <controls:ConceptMetadataFieldControl x:Name="SetupAuthorField" PresentationMode="Minimal"/>
                                    <controls:ConceptMetadataFieldControl x:Name="SetupNarratorField" PresentationMode="Minimal"/>
                                    <controls:ConceptMetadataFieldControl x:Name="SetupGenreField" PresentationMode="Minimal"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <TextBlock x:Name="ErrorText"
                                   Grid.Row="1"
                                   Foreground="{DynamicResource ErrorTextBrush}"
                                   Visibility="Collapsed"
                                   Margin="0,10,0,0"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
                <ScrollViewer x:Name="SetupPage1"
                              Visibility="Collapsed"
                              IsHitTestVisible="False"
                              Focusable="False"
                              Style="{StaticResource ConceptStableVerticalGutterScrollViewerStyle}">
                    <ScrollViewer.RenderTransform><TranslateTransform x:Name="SetupPage1Transform"/></ScrollViewer.RenderTransform>
                    <Grid x:Name="SetupPage1ViewportRoot"
                          MinHeight="{Binding ActualHeight, ElementName=SetupPageHost}">
                        <Grid x:Name="SetupPage1CardsGrid" Margin="22,12,8,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SetupPage1LeftCard"
                                Grid.Column="0"
                                Background="{DynamicResource ProjectSetupCardBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <controls:ConceptSeriesFieldControl x:Name="SetupSeriesField" ColumnGap="12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ConceptSpecialMetadataFieldControl x:Name="SetupAbridgedStatusField" Grid.Column="0"/>
                                    <controls:ConceptSpecialMetadataFieldControl x:Name="SetupWorkTypeField" Grid.Column="2"/>
                                </Grid>
                                <Grid x:Name="SetupYearIsbnFieldsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <controls:ConceptSpecialMetadataFieldControl x:Name="SetupYearField"
                                                                                  Grid.Column="0"/>
                                    <controls:ConceptMetadataFieldControl x:Name="SetupIsbnField"
                                                                          Grid.Column="2"
                                                                          UseFullWidth="True"/>
                                </Grid>
                                <controls:ConceptCompatibilityFieldControl x:Name="SetupCompatibilityField"
                                                                            Margin="0,0,0,14"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="SetupPage1RightCard"
                                Grid.Column="2"
                                Background="{DynamicResource ProjectSetupCardBackgroundBrush}"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <controls:ConceptDescriptionFieldControl x:Name="SetupDescriptionField"
                                                                     PresentationMode="Stretch"
                                                                     VerticalAlignment="Stretch"/>
                        </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button x:Name="StartProjectButton"
                            Content="{services:LocalizedText Key=UiProjektStarten}"
                            TabIndex="5"
                            Width="130"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OkButton_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="SortTracksButton"
                            Content="{services:LocalizedText Key=UiTracksSortieren}"
                            TabIndex="6"
                            Width="120"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="SortTracksButton_Click"/>
                </StackPanel>
            </Border>
    </Grid>
</Window>
