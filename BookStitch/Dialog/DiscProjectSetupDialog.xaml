<Window x:Class="BookStitch.Dialog.DiscProjectSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        Title="Projekt vorbereiten"
        Icon="/Assets/Icons/BookStitchAppIcon-Simplified-multisize.ico"
        Width="980"
        Height="600"
        MinWidth="860"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="#101418"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI"
        KeyboardNavigation.TabNavigation="Cycle">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DisabledButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#22303A"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,12,10"/>
            </Style>

            <Style x:Key="SourceFolderLinkStyle" TargetType="Button">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource MainTextBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>

            <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DarkComboBoxStyle}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="DialogStepButtonStyle" TargetType="RepeatButton">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="4,0,0,10"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Delay" Value="400"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Interval" Value="90"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#0F5F63"/>
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#0F5F63"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Foreground="{StaticResource AccentSoftBrush}"
                               FontWeight="Bold"
                               FontSize="18"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Width="42"
                            Height="42"
                            Margin="0,0,4,0"
                            Padding="0"
                            Foreground="{StaticResource AccentSoftBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="Advanced Settings öffnen"
                            IsTabStop="False"
                            Click="SettingsButton_Click">
                        <Button.Content>
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="24"
                                       Foreground="{StaticResource AccentSoftBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button.Content>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SettingsBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SettingsBorder" Property="Background" Value="#1B2A31"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="SettingsBorder" Property="Background" Value="#20343B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="2"
                            Content="×"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,16,22,10">
                    <TextBlock x:Name="SourceInformationText"
                               Foreground="{StaticResource MainTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,7"/>
                    <TextBlock x:Name="InstructionText"
                               Foreground="{StaticResource MainTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#151C23"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Projekt-Einstellungen" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="DiscCountLabel" Grid.Row="0" Text="Anzahl CDs" Style="{StaticResource DialogLabelStyle}"/>
                                    <Grid x:Name="DiscCountPanel" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DiscCountTextBox"
                                                 TabIndex="13"
                                                 HorizontalContentAlignment="Center"
                                                 PreviewTextInput="NumberTextBox_PreviewTextInput"
                                                 PreviewMouseWheel="DiscCountTextBox_PreviewMouseWheel"
                                                 KeyDown="DiscCountTextBox_KeyDown"
                                                 Style="{StaticResource DialogTextBoxStyle}"/>
                                        <RepeatButton Grid.Column="1" Content="▲" ToolTip="CD-Anzahl erhöhen" Style="{StaticResource DialogStepButtonStyle}" Click="IncreaseDiscCount_Click"/>
                                        <RepeatButton Grid.Column="2" Content="▼" ToolTip="CD-Anzahl verringern" Style="{StaticResource DialogStepButtonStyle}" Click="DecreaseDiscCount_Click"/>
                                    </Grid>

                                    <TextBlock x:Name="ProjectFolderLabel" Grid.Row="0" Text="Quellordner" Style="{StaticResource DialogLabelStyle}" Visibility="Collapsed"/>
                                    <Button x:Name="ProjectFolderButton"
                                            IsTabStop="False"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,10"
                                            Style="{StaticResource SourceFolderLinkStyle}"
                                            Cursor="Hand"
                                            Visibility="Collapsed"
                                            Click="ProjectFolderButton_Click"/>

                                    <TextBlock Grid.Row="1" Text="Export-Preset" Style="{StaticResource DialogLabelStyle}"/>
                                    <ComboBox x:Name="PresetComboBox"
                                              TabIndex="7"
                                              Grid.Row="1"
                                              Grid.Column="1"
                                              Width="274"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="PresetComboBox_SelectionChanged"
                                              Style="{StaticResource DialogComboBoxStyle}"/>

                                    <TextBlock Grid.Row="2" Text="Parallel-Jobs" Style="{StaticResource DialogLabelStyle}"/>
                                    <Grid Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ParallelJobsTextBox"
                                                 TabIndex="8"
                                                 HorizontalContentAlignment="Center"
                                                 ToolTip="Auto oder eine Zahl von 1 bis 40"
                                                 PreviewTextInput="ParallelJobsTextBox_PreviewTextInput"
                                                 PreviewMouseWheel="ParallelJobsTextBox_PreviewMouseWheel"
                                                 KeyDown="ParallelJobsTextBox_KeyDown"
                                                 Style="{StaticResource DialogTextBoxStyle}"/>
                                        <RepeatButton Grid.Column="1" Content="▲" ToolTip="Parallel-Jobs erhöhen" Style="{StaticResource DialogStepButtonStyle}" Click="IncreaseParallelJobs_Click"/>
                                        <RepeatButton Grid.Column="2" Content="▼" ToolTip="Parallel-Jobs verringern" Style="{StaticResource DialogStepButtonStyle}" Click="DecreaseParallelJobs_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="3" Text="Endung" Style="{StaticResource DialogLabelStyle}"/>
                                    <ComboBox x:Name="OutputExtensionComboBox"
                                              TabIndex="9"
                                              Grid.Row="3"
                                              Grid.Column="1"
                                              Width="64"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="OutputExtensionComboBox_SelectionChanged"
                                              Style="{StaticResource DialogComboBoxStyle}">
                                        <ComboBoxItem Content=".m4a"/>
                                        <ComboBoxItem Content=".m4b"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="4" Text="Ausgabeordner" Style="{StaticResource DialogLabelStyle}"/>
                                    <Grid Grid.Row="4" Grid.Column="1" Width="274" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderTextBox"
                                                 IsTabStop="False"
                                                 IsReadOnly="True"
                                                 ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                 Style="{StaticResource DialogTextBoxStyle}"/>
                                        <Button x:Name="ChooseOutputFolderButton"
                                                Grid.Column="1"
                                                Content="..."
                                                Width="36"
                                                Height="32"
                                                Margin="6,0,0,10"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                ToolTip="Ausgabeordner wählen"
                                                TabIndex="10"
                                                Click="ChooseOutputFolder_Click"/>
                                    </Grid>

                                    <TextBlock Grid.Row="5" Text="Dateiname" Style="{StaticResource DialogLabelStyle}"/>
                                    <ComboBox x:Name="FileNameTemplateTextBox"
                                              TabIndex="11"
                                              Grid.Row="5"
                                              Grid.Column="1"
                                              Width="274"
                                              HorizontalAlignment="Left"
                                              IsEditable="True"
                                              KeyDown="Input_KeyDown"
                                              KeyUp="MetadataComboBox_KeyUp"
                                              LostFocus="MetadataComboBox_LostFocus"
                                              SelectionChanged="MetadataComboBox_SelectionChanged"
                                              Style="{StaticResource DialogComboBoxStyle}">
                                        <ComboBoxItem Content="{}{Autor} - {Titel}"/>
                                        <ComboBoxItem Content="{}{Titel} - {Autor}"/>
                                        <ComboBoxItem Content="{}{Titel}"/>
                                        <ComboBoxItem Content="{}{Autor} - {Sprecher} - {Titel}"/>
                                    </ComboBox>

                                    <TextBlock Grid.Row="6" Text="Vorschau" Style="{StaticResource DialogLabelStyle}"/>
                                    <TextBlock x:Name="PreviewTextBlock"
                                               Grid.Row="6"
                                               Grid.Column="1"
                                               Foreground="{StaticResource MainTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,10"/>

                                    <StackPanel Grid.Row="7"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="0,8,0,0"
                                                ToolTip="Das Hörbuch wird nach dem Konvertieren ohne zusätzliche Prüfung zusammengefügt.">
                                        <TextBlock Text="Auto-Zusammenfügen"
                                                   Foreground="{StaticResource MainTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <CheckBox x:Name="AutoMergeCheckBox"
                                                  TabIndex="12"
                                                  VerticalAlignment="Center"
                                                  ToolTip="Das Hörbuch wird nach dem Konvertieren ohne zusätzliche Prüfung zusammengefügt."
                                                  Checked="AutoMergeCheckBox_Changed"
                                                  Unchecked="AutoMergeCheckBox_Changed"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#151C23"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Cover und Metadaten" Style="{StaticResource SectionTitleStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="136"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="Titel" Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox x:Name="TitleTextBox" TabIndex="0" Grid.Row="0" Grid.Column="1" TextChanged="TitleTextBox_TextChanged" KeyDown="Input_KeyDown" Style="{StaticResource DialogTextBoxStyle}"/>
                                        <TextBlock x:Name="AlbumLabel" Grid.Row="1" Text="Album" Style="{StaticResource DialogLabelStyle}" Cursor="Hand" MouseLeftButtonUp="AlbumLabel_MouseLeftButtonUp"/>
                                        <TextBox x:Name="AlbumTextBox" TabIndex="1" Grid.Row="1" Grid.Column="1" TextChanged="AlbumTextBox_TextChanged" KeyDown="Input_KeyDown" Style="{StaticResource DialogTextBoxStyle}"/>
                                        <TextBlock Grid.Row="2" Text="Autor" Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox x:Name="AuthorTextBox" TabIndex="2" Grid.Row="2" Grid.Column="1" TextChanged="MetadataTextBox_TextChanged" KeyDown="Input_KeyDown" Style="{StaticResource DialogTextBoxStyle}"/>
                                        <TextBlock Grid.Row="3" Text="Sprecher" Style="{StaticResource DialogLabelStyle}"/>
                                        <TextBox x:Name="NarratorTextBox" TabIndex="3" Grid.Row="3" Grid.Column="1" TextChanged="MetadataTextBox_TextChanged" KeyDown="Input_KeyDown" Style="{StaticResource DialogTextBoxStyle}"/>
                                        <TextBlock Grid.Row="4" Text="Genre" Style="{StaticResource DialogLabelStyle}"/>
                                        <ComboBox x:Name="GenreTextBox"
                                                  TabIndex="4"
                                                  Grid.Row="4"
                                                  Grid.Column="1"
                                                  IsEditable="True"
                                                  KeyDown="Input_KeyDown"
                                                  KeyUp="MetadataComboBox_KeyUp"
                                                  LostFocus="MetadataComboBox_LostFocus"
                                                  SelectionChanged="MetadataComboBox_SelectionChanged"
                                                  Style="{StaticResource DialogComboBoxStyle}">
                                            <ComboBoxItem Content="iBook Hörbuch"/>
                                            <ComboBoxItem Content="iBook Kleinkunst"/>
                                            <ComboBoxItem Content="iBook Wissen"/>
                                            <ComboBoxItem Content="Podcast"/>
                                            <ComboBoxItem Content="iBook Kinderbücher DE"/>
                                            <ComboBoxItem Content="iBook Kinderbücher CH"/>
                                            <ComboBoxItem Content="Audiobook"/>
                                            <ComboBoxItem Content="Hörbuch"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border x:Name="CoverBorder"
                                            Grid.Column="2"
                                            Width="128"
                                            Height="128"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="#11161B"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Cursor="Hand"
                                            ToolTip="Cover auswählen"
                                            MouseLeftButtonUp="CoverBorder_MouseLeftButtonUp"
                                            ContextMenuOpening="CoverBorder_ContextMenuOpening">
                                        <Border.ContextMenu>
                                            <ContextMenu Style="{StaticResource BookStitchContextMenuStyle}">
                                                <MenuItem Header="Cover entfernen" Style="{StaticResource BookStitchContextMenuItemStyle}" Click="RemoveCover_Click"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ClipToBounds="True">
                                            <Image x:Name="CoverPreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Opacity="0.95"/>
                                            <Border Background="#99000000" VerticalAlignment="Bottom" Padding="4,3">
                                                <TextBlock x:Name="CoverHintText" Text="Cover wählen" Foreground="{StaticResource AccentSoftBrush}" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Foreground="#FF7070" Visibility="Collapsed" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#151C23" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button x:Name="StartProjectButton"
                            Content="Projekt starten"
                            TabIndex="5"
                            Width="130"
                            Height="34"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="OkButton_Click"
                            Margin="0,0,8,0"/>
                    <Button x:Name="SortTracksButton"
                            Content="Tracks sortieren"
                            TabIndex="6"
                            Width="120"
                            Height="34"
                            IsCancel="True"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
