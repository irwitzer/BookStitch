<Window x:Class="BookStitch.Dialog.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:BookStitch.Services"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{services:LocalizedText Key=UiBookStitch}"
        Icon="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-OpenBook.ico"

        Width="620"
        Height="340"
        MinWidth="480"
        MinHeight="230"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        KeyboardNavigation.TabNavigation="Cycle">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
</ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource AppBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="{DynamicResource BrandLogoImageSource}"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"
                           Margin="12,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="{services:LocalizedText Key=UiBookStitch}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>


                    <Button Grid.Column="3"
                            Content="×"
                            Margin="0,0,7,0"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="IconCircle"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource AccentForegroundBrush}"
                        Background="{DynamicResource InputBackgroundBrush}"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,1,0,12">
                    <TextBlock x:Name="HeadingText"
                               Text="{services:LocalizedText Key=UiHinweis}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="MessageText"
                               Text="{services:LocalizedText Key=UiMeldung}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MainTextBrush}"
                               TextWrapping="Wrap"/>
                    <ContentControl x:Name="AdditionalContent" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <Border x:Name="DetailsBorder"
                        Grid.Row="1"
                        Grid.Column="1"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DetailsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Margin="0,0,0,5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MainTextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
