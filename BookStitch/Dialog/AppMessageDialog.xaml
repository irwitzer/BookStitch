<Window x:Class="BookStitch.Dialog.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="BookStitch"
        Icon="/Assets/Icons/BookStitchAppIcon-Simplified-multisize.ico"
        
        Width="620"
        Height="340"
        MinWidth="480"
        MinHeight="230"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        KeyboardNavigation.TabNavigation="Cycle">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="7"
                            CornerRadius="8"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DisabledButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#22303A"/>
                        <Setter Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource PanelBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="/Assets/Icons/BookStitchLogo-Round.png"
                           Width="28"
                           Height="28"
                           Stretch="Uniform"
                           Margin="12,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="BookStitch"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentSoftBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button Grid.Column="2"
                            Content="×"
                            Margin="0,0,7,0"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="20,18,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="IconCircle"
                        Grid.Row="0"
                        Grid.Column="0"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        BorderThickness="1"
                        BorderBrush="{StaticResource AccentSoftBrush}"
                        Background="#14252A"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               Text="i"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentSoftBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,1,0,12">
                    <TextBlock x:Name="HeadingText"
                               Text="Hinweis"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="MessageText"
                               Text="Meldung"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource MainTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border x:Name="DetailsBorder"
                        Grid.Row="1"
                        Grid.Column="1"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource InputBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DetailsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               Margin="0,0,0,5"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MainTextBrush}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBackgroundBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14">
                <StackPanel x:Name="ButtonsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>
