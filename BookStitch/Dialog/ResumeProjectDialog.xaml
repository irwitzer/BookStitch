<Window x:Class="BookStitch.Dialog.ResumeProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:controls="clr-namespace:BookStitch.Controls"
        xmlns:services="clr-namespace:BookStitch.Services"
        Title="{services:LocalizedText Key=UiProjekte}"
        Icon="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-OpenBook.ico"
        Width="820"
        Height="560"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown"
        Style="{StaticResource LargeResizableWindowStyle}">



    <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <controls:LargeResizableWindowHeader Grid.Row="0"
                                             Margin="-18,-18,-18,16"
                                             Padding="18,0"
                                             CloseRequested="Close_Click">
            <controls:LargeResizableWindowHeader.TitleContent>
                <TextBlock Text="{services:LocalizedText Key=UiProjektFortsetzen}"
                           Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"/>
            </controls:LargeResizableWindowHeader.TitleContent>
        </controls:LargeResizableWindowHeader>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{services:LocalizedText Key=UiProjekt}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MainTextBrush}"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="ProjectsComboBox"
                          TabIndex="3"
                          Grid.Column="1"
                          Height="32"
                          Style="{StaticResource AppearanceComboBoxStyle}"
                          ItemsSource="{Binding Projects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemTemplate="{StaticResource ProjectTypeListItemTemplate}"
                          IsEnabled="{Binding CanSelectProjects}"
                          DropDownOpened="ProjectsComboBox_DropDownOpened">
                </ComboBox>

                <Button x:Name="RefreshProjectsButton"
                        Grid.Column="2"
                        Content="{services:LocalizedText Key=UiAktualisieren}"
                        TabIndex="4"
                        MinWidth="115"
                        Style="{StaticResource SecondaryCompactButtonStyle}"
                        IsEnabled="{Binding CanRefreshProjects}"
                        Click="Refresh_Click"
                        Margin="10,0,0,0"/>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource InputBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    MinHeight="210"
                    Margin="0,0,0,16">
                <Grid x:Name="ProjectInfoPanel">
                    <ScrollViewer x:Name="ProjectInfoScrollViewer"
                                  Margin="0,0,-6,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  HorizontalContentAlignment="Stretch"
                                  CanContentScroll="False"
                                  controls:SmoothMouseWheelScrollBehavior.IsEnabled="True"
                                  controls:SmoothMouseWheelScrollBehavior.DurationMilliseconds="120"
                                  controls:SmoothMouseWheelScrollBehavior.Step="24">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}"
                                   BasedOn="{StaticResource AppearanceRoundedScrollBarStyle}"/>
                        </ScrollViewer.Resources>

                        <Grid x:Name="ProjectInfoScrollableContent" Margin="0,56,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
<TextBlock Text="{Binding SelectedProject.HealthMessage}" TextWrapping="Wrap" Margin="0,0,0,6">
 <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
 <Style.Triggers><DataTrigger Binding="{Binding SelectedProject.HealthStatus}" Value="Damaged"><Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/></DataTrigger></Style.Triggers>
 </Style></TextBlock.Style></TextBlock>
 <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="{Binding ProjectDetails}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MainTextBrush}"/>
</StackPanel>

                            <Border Grid.Row="0"
                                    Grid.Column="1"
                                    Width="220"
                                    Height="220"
                                    Margin="18,0,4,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource CoverDisplayBorderStyle}">
                                <Image Source="{Binding ProjectCoverSource}"
                                       Style="{StaticResource CoverDisplayImageStyle}"/>
                            </Border>

                            <StackPanel Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Stretch">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedProject.OutputFolder}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{services:LocalizedText Key=UiAusgabe}" FontWeight="SemiBold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SelectedProject.OutputFolder}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource MainTextBrush}">
                                    <Run Text="{services:LocalizedText Key=UiProjektordner2}" FontWeight="SemiBold"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding SelectedProject.ProjectFolderDisplay, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <controls:FadeHeader x:Name="ProjectInfoHeaderOverlay"
                                         Style="{StaticResource AppearanceFadeHeaderStyle}"
                                         HeaderHeight="32"
                                         FadeHeight="24"
                                         Margin="0,0,18,0"
                                         VerticalAlignment="Top"
                                         Panel.ZIndex="1">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Content="{Binding SelectedProject}" ContentTemplate="{StaticResource ProjectTypeIconTemplate}"/>
                            <TextBlock Text="{Binding ProjectHeaderTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </controls:FadeHeader>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="DeleteProjectButton"
                        Grid.Column="0"
                        Content="{services:LocalizedText Key=UiProjektLoeschen}"
                        TabIndex="2"
                        MinWidth="120"
                        Style="{StaticResource QuietDangerButtonStyle}"
                        IsEnabled="{Binding HasSelectedProject}"
                        Click="DeleteProject_Click"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{services:LocalizedText Key=Resume.Project.OpenFolder}" IsEnabled="{Binding HasSelectedProject}"
                             Click="OpenSelectedProjectFolder_Click" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProject.ShowProjectFolder}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    <Button x:Name="RebuildProjectButton" Content="{services:LocalizedText Key=Integrity.Rebuild}" Click="RebuildProject_Click" Margin="0,0,8,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedProject.CanRebuild}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button x:Name="LoadProjectButton"
                            Content="{services:LocalizedText Key=UiProjektLaden}"
                            TabIndex="0"
                            MinWidth="120"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanLoadSelectedProject}"
                            IsDefault="True"
                            Click="LoadProject_Click"
                            Margin="0,0,8,0"/>

                    <Button x:Name="CloseProjectDialogButton"
                            Content="{services:LocalizedText Key=UiSchliessen}"
                            TabIndex="1"
                            MinWidth="100"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsCancel="True"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>
    </Grid>
</Window>
