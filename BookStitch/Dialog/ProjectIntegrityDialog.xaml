<Window x:Class="BookStitch.Dialog.ProjectIntegrityDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:BookStitch.Controls" xmlns:services="clr-namespace:BookStitch.Services" Title="{services:LocalizedText Key=Integrity.WindowTitle}"
 Width="720" Height="460" MinWidth="620" MinHeight="360" WindowStartupLocation="CenterOwner"
 Style="{StaticResource LargeResizableWindowStyle}" ShowInTaskbar="False" Foreground="{DynamicResource MainTextBrush}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <controls:LargeResizableWindowHeader CloseRequested="Close_Click" Padding="14,0,8,0"><controls:LargeResizableWindowHeader.TitleContent><TextBlock Text="{services:LocalizedText Key=Integrity.WindowTitle}" Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"/></controls:LargeResizableWindowHeader.TitleContent></controls:LargeResizableWindowHeader>
 <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <TextBlock x:Name="HeadingText" Text="{services:LocalizedText Key=Integrity.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>
 <TextBlock x:Name="ExplanationText" Grid.Row="1" Text="{services:LocalizedText Key=Integrity.Explanation}" TextWrapping="Wrap" Margin="0,0,0,14"/>
 <TextBlock x:Name="PhaseText" Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,12"/>
 <ProgressBar x:Name="Progress" Grid.Row="2" Height="18" IsIndeterminate="True" Margin="0,0,0,12" AutomationProperties.Name="{services:LocalizedText Key=Integrity.Title}"/>
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Row="4" Margin="0,16,0,16"><TextBlock x:Name="ResultText" TextWrapping="Wrap"/></ScrollViewer>
 <Button x:Name="CancelButton" Grid.Row="5" Content="{services:LocalizedText Key=Common.Cancel}" HorizontalAlignment="Right"
 MinWidth="110" Style="{StaticResource SettingsSecondaryButtonStyle}" Click="Cancel_Click"/>
 </Grid></Grid>
</Window>
