<Window x:Class="BookStitch.Dialog.DeveloperAudioDiscTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Disc-Kurztest" Width="680" Height="590" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource MainTextBrush}" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Entwickler-Kurztest" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentSoftBrush}"/>
            <TextBlock Text="Setzt die letzten Tracks eines vorbereiteten Testprojekts zurück und startet danach den normalen Disc-Pfad." TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Testtyp" VerticalAlignment="Center" Margin="0,0,12,12"/>
            <ComboBox x:Name="ProjectTypeComboBox" Grid.Column="1" Height="32" Margin="0,0,0,12" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" SelectionChanged="ProjectTypeComboBox_SelectionChanged">
                <ComboBoxItem Content="Audio-CD-Projekt" Tag="AudioCd"/>
                <ComboBoxItem Content="MP3-CD-Projekt" Tag="Mp3Disc"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="Projektordner" VerticalAlignment="Center" Margin="0,0,12,12"/>
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Auswählen" Width="100" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="SelectFolder_Click"/>
                <TextBox x:Name="ProjectFolderTextBox" Height="32" TextChanged="ProjectFolderTextBox_TextChanged"/>
            </DockPanel>

            <TextBlock Grid.Row="2" Text="Projektdaten" VerticalAlignment="Top" Margin="0,4,12,12"/>
            <Border Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Titel" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,5"/>
                    <TextBlock x:Name="ProjectTitleTextBlock" Grid.Column="1" Text="–" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Text="Autor" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,5"/>
                    <TextBlock x:Name="ProjectAuthorTextBlock" Grid.Row="1" Grid.Column="1" Text="–" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Text="Sprecher" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ProjectNarratorTextBlock" Grid.Row="2" Grid.Column="1" Text="–" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <TextBlock Grid.Row="3" Text="CD-Laufwerk" VerticalAlignment="Center" Margin="0,0,12,12"/>
            <ComboBox x:Name="DriveComboBox" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,0,0,12" Style="{StaticResource DarkComboBoxStyle}"/>

            <TextBlock x:Name="DiscNumberLabel" Grid.Row="4" Text="Erneut zu rippende CD" VerticalAlignment="Center" Margin="0,0,12,12"/>
            <TextBox x:Name="DiscNumberTextBox" Grid.Row="4" Grid.Column="1" Height="32" Text="1" Margin="0,0,0,12"/>

            <TextBlock x:Name="TrackCountLabel" Grid.Row="5" Text="Letzte Tracks erneut" VerticalAlignment="Center" Margin="0,0,12,12"/>
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="TrackCountTextBox" Width="90" Height="32" Text="3"/>
                <TextBlock Text="Gesamtzahl CDs" VerticalAlignment="Center" Margin="24,0,10,0"/>
                <TextBox x:Name="TotalDiscsTextBox" Width="90" Height="32" Text="2"/>
            </StackPanel>

            <Border Grid.Row="6" Grid.ColumnSpan="2" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <TextBlock x:Name="InfoTextBlock" Text="Das ausgewählte Testprojekt bleibt unverändert. BookStitch erstellt für jeden Kurztest eine neue Arbeitskopie und setzt nur dort die gewählten letzten FLAC- und AAC-Dateien zurück." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Abbrechen" Width="110" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
            <Button Content="Kurztest starten" Width="150" Height="34" Style="{StaticResource PrimaryButtonStyle}" Click="Start_Click"/>
        </StackPanel>
    </Grid>
</Window>
