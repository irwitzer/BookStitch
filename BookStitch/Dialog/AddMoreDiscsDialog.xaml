<Window x:Class="BookStitch.Dialog.AddMoreDiscsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        Title="Weitere CDs hinzufügen"
        Icon="/Assets/Icons/BookStitchAppIcon-Simplified-multisize.ico"
        Width="640"
        Height="570"
        MinHeight="410"
        MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#101418"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DisabledButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            </Style>
            <Style x:Key="DialogStepButtonStyle" TargetType="RepeatButton">
                <Setter Property="Width" Value="24"/><Setter Property="Height" Value="26"/><Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Delay" Value="400"/><Setter Property="Interval" Value="90"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#0F5F63"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="DiscDriveListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#202A32"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#35414D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="ItemBorder" Property="Background" Value="#17383B"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#111820" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid Margin="14,0"><TextBlock Text="Weitere CDs hinzufügen" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/><Button Content="×" HorizontalAlignment="Right" Style="{StaticResource DialogCloseButtonStyle}" IsTabStop="False" Click="CloseButton_Click"/></Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <TextBlock Text="Weitere CDs hinzufügen" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,14"/>
                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="68"/><ColumnDefinition Width="4"/><ColumnDefinition Width="24"/><ColumnDefinition Width="4"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="Gesamtzahl CDs:" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox x:Name="TotalDiscsTextBox" TabIndex="0" Grid.Column="1" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" PreviewTextInput="TotalDiscsTextBox_PreviewTextInput" KeyDown="TotalDiscsTextBox_KeyDown" PreviewMouseWheel="TotalDiscsTextBox_PreviewMouseWheel"/><RepeatButton Grid.Column="3" Content="▲" Style="{StaticResource DialogStepButtonStyle}" Click="IncreaseTotalDiscs_Click"/><RepeatButton Grid.Column="5" Content="▼" Style="{StaticResource DialogStepButtonStyle}" Click="DecreaseTotalDiscs_Click"/></Grid>
                <TextBlock Text="Wähle das Laufwerk mit der nächsten CD aus." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <ListBox x:Name="DriveList" IsTabStop="False" Height="230" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource DiscDriveListItemStyle}" MouseDoubleClick="DriveList_MouseDoubleClick">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="8,7"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Grid Width="24" Height="24"><Ellipse Stroke="{StaticResource AccentSoftBrush}" StrokeThickness="1.6" Fill="#102326"/><Ellipse Width="7" Height="7" Stroke="{StaticResource AccentSoftBrush}" StrokeThickness="1.4" Fill="{StaticResource InputBackgroundBrush}"/><Path Data="M 5,8 A 8,8 0 0 1 16,4" Stroke="#D6F7F8" StrokeThickness="1.2"/></Grid></Viewbox><TextBlock Grid.Column="1" Text="{Binding DriveLetter}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="ErrorText" Foreground="#FF7070" Visibility="Collapsed" Margin="0,8,0,0"/>
            </StackPanel>
            <Border Grid.Row="2" Background="#151C23" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"><Button Content="Weiter" TabIndex="1" Width="105" Height="34" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="OkButton_Click" Margin="0,0,8,0"/><Button Content="Abbrechen" TabIndex="2" Width="105" Height="34" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CancelButton_Click"/></StackPanel></Border>
        </Grid>
    </Border>
</Window>
