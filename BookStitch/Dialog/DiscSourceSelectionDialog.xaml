<Window x:Class="BookStitch.Dialog.DiscSourceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        Title="CD-Laufwerk auswählen"
        Icon="/Assets/Icons/BookStitchAppIcon-Simplified-multisize.ico"
        Width="620"
        Height="430"
        MinHeight="310"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#101418"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI"
        KeyboardNavigation.TabNavigation="Cycle"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="Background" Value="{StaticResource DisabledButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
            </Style>

            <Style x:Key="DiscDriveListItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource MainTextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#202A32"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#35414D"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#17383B"/>
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#1B4549"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Background="{StaticResource PanelBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#111820" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1" dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid Margin="14,0">
                    <TextBlock Text="CD-Laufwerk auswählen" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource DialogCloseButtonStyle}" IsTabStop="False" Click="CancelButton_Click"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="24,20,24,0">
                <TextBlock Text="Wähle das gewünschte CD-Laufwerk aus." FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="BookStitch verwendet ausschließlich das ausgewählte CD-Laufwerk." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <ListBox x:Name="DriveList" IsTabStop="False" Height="220" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{StaticResource InputBackgroundBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" ItemContainerStyle="{StaticResource DiscDriveListItemStyle}" MouseDoubleClick="DriveList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid Width="24" Height="24">
                                        <Ellipse Stroke="{StaticResource AccentSoftBrush}" StrokeThickness="1.6" Fill="#102326"/>
                                        <Ellipse Width="7" Height="7" Stroke="{StaticResource AccentSoftBrush}" StrokeThickness="1.4" Fill="{StaticResource InputBackgroundBrush}"/>
                                        <Path Data="M 5,8 A 8,8 0 0 1 16,4" Stroke="#D6F7F8" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Grid.Column="1" Text="{Binding DriveLetter}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#D6F7F8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
            <Border Grid.Row="2" Background="#151C23" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button x:Name="UseDriveButton" Content="Laufwerk verwenden" TabIndex="0" Width="150" Height="34" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Click="UseDriveButton_Click" Margin="0,0,8,0"/>
                    <Button Content="Abbrechen" TabIndex="1" Width="105" Height="34" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Click="CancelButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
