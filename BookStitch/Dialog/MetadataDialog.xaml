<Window x:Class="BookStitch.Dialog.MetadataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:services="clr-namespace:BookStitch.Services"
        xmlns:presentation="clr-namespace:BookStitch.Presentation"
        xmlns:controls="clr-namespace:BookStitch.Controls"
        Title="{services:LocalizedText Key=UiMetadaten}"
        Width="960"
        Height="720"
        MinWidth="920"
        MinHeight="590"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="MetadataDialog_PreviewKeyDown"
        FontFamily="Segoe UI"
        Style="{StaticResource LargeResizableWindowStyle}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStitch;component/Themes/ConceptDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="ConceptImmediateEnumCandidateStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource ConceptCandidateComboBoxItemStyle}">
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ConceptEnumCandidateComboBox_PreviewMouseLeftButtonUp"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="ConceptBooleanToVisibilityConverter"/>

        <Style x:Key="ConceptHelpBodyTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ConceptHelpItemTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ConceptHelpSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ConceptHelpSectionHeaderStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,8,0,10"/>
        </Style>




        <DataTemplate x:Key="ConceptMetadataFamilyCoverTemplate">
            <Border Width="170"
                    Height="170"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Cursor="Hand"
                    Style="{StaticResource CoverDisplayBorderStyle}"
                    MouseLeftButtonUp="ConceptQuickAccessCoverPreview_MouseLeftButtonUp"
                    AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.CoverNavigate}">
                <Image Source="{Binding}"
                       Style="{StaticResource CoverDisplayImageStyle}"/>
            </Border>
        </DataTemplate>



        <Style x:Key="ConceptSegmentButtonStyle"
               TargetType="Button" BasedOn="{StaticResource StandardButtonGeometryStyle}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BookStitchKeyboardFocusVisualStyle}"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ConceptAddButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ConceptSegmentButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8,0,0,8">
                            <TextBlock x:Name="Glyph"
                                       Text="+"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource NeutralPressedBackgroundBrush}"/>
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource OnAccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConceptRemoveButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ConceptSegmentButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0,8,8,0">
                            <TextBlock x:Name="Glyph"
                                       Text="×"
                                       FontSize="18"
                                       Foreground="{DynamicResource WarningProgressForegroundBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource QuietDangerHoverBackgroundBrush}"/>
                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="{DynamicResource QuietDangerHoverBorderBrush}"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource QuietDangerHoverTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="{DynamicResource QuietDangerPressedBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConceptFamilyListItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="FamilyItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FamilyItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource InputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="FamilyItemBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ConceptSingleValueBadgeStyle"
               TargetType="Border">
            <EventSetter Event="MouseLeftButtonDown" Handler="SingleValueBadge_MouseLeftButtonDown"/>
            <Setter Property="MinHeight" Value="23"/>
            <Setter Property="Padding" Value="9,3,4,3"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDuplicateHighlighted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DuplicateWarningBackgroundBrush}"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="TrackNumber"/>
                        <Condition Binding="{Binding DataContext.IsTrackNumberLocked, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Padding" Value="9,3,9,3"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="TrackCount"/>
                        <Condition Binding="{Binding DataContext.IsTrackCountLocked, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Padding" Value="9,3,9,3"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:LargeResizableWindowHeader Grid.Row="0"
                                             TitleAreaWidth="200"
                                             Padding="0,0,8,0"
                                             CloseRequested="Close_Click">
            <controls:LargeResizableWindowHeader.TitleContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{services:LocalizedText Key=UiMetadaten}"
                           Margin="16,0,0,0"
                           Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"/>
                    <Button Width="34"
                            Margin="6,0,0,0"
                            Style="{StaticResource DeveloperToolsButtonStyle}"
                            AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.OpenDeveloperTools}"
                            Command="{x:Static services:DeveloperToolsCommands.OpenDeveloperToolsWindow}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.TitleContent>

            <controls:LargeResizableWindowHeader.CenterContent>
                <Grid Height="28"
                      Width="{Binding ActualWidth, ElementName=ConceptEditorColumnMetric}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="ConceptSearchTextBox"
                             Style="{StaticResource ConceptSearchTextBoxStyle}"
                             TextChanged="ConceptSearchTextBox_TextChanged"
                             PreviewKeyDown="ConceptSearchTextBox_PreviewKeyDown"
                             AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.SearchMetadata}"
                             AutomationProperties.HelpText="{services:LocalizedText Key=Metadata.Automation.SearchHelp}"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                    <Button Style="{StaticResource ConceptSearchAdornmentButtonStyle}"
                            Content="{Binding SearchAdornment}"
                            Click="ConceptSearchAdornment_Click"
                            AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.SearchClearOrFocus}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </controls:LargeResizableWindowHeader.CenterContent>

            <controls:LargeResizableWindowHeader.HeaderActions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">


                    <Button Width="34"
                            Margin="0"
                            Style="{StaticResource GlobalSettingsButtonStyle}"
                            AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.OpenGlobalSettings}"
                            Click="OpenSettings_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.HeaderActions>
        </controls:LargeResizableWindowHeader>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="12,16,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{services:LocalizedText Key=UiMetadatengruppen}"
                                   Margin="8,0,8,8"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <ListBox x:Name="ConceptFamilyList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ConceptFamilyListItemStyle}"
                                 SelectionChanged="ConceptFamilyList_SelectionChanged"
                                 AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.MetadataGroups}">
                            <ListBoxItem x:Name="ConceptQuickAccessFamilyItem"
                                         Content="{services:LocalizedText Key=UiSchnellzugriff}"/>
                            <ListBoxItem x:Name="ConceptWorkOutputFamilyItem"
                                         Content="{services:LocalizedText Key=UiWerk}"/>
                            <ListBoxItem x:Name="ConceptPeopleFamilyItem"
                                         Content="{services:LocalizedText Key=UiPersonen}"/>
                            <ListBoxItem x:Name="ConceptPublicationFamilyItem"
                                         Content="{services:LocalizedText Key=UiVeroeffentlichung}"/>
                            <ListBoxItem x:Name="ConceptLanguageFamilyItem"
                                         Content="{services:LocalizedText Key=UiSprache}"/>
                            <ListBoxItem x:Name="ConceptCatalogDataFamilyItem"
                                         Content="{DynamicResource MetadataGroupCatalogData}"/>
                            <ListBoxItem x:Name="ConceptSortingFamilyItem"
                                         Content="{services:LocalizedText Key=UiSortierung}"/>
                            <ListBoxItem x:Name="ConceptDescriptionFamilyItem"
                                         Content="{services:LocalizedText Key=UiBeschreibung}"/>
                            <ListBoxItem x:Name="ConceptCompatibilityFamilyItem"
                                         Content="{DynamicResource MetadataGroupCompatibility}"/>
                            <ListBoxItem x:Name="ConceptCoverFamilyItem"
                                         Content="{services:LocalizedText Key=UiCover}"/>
                            <ListBoxItem x:Name="ConceptTechnicalDataFamilyItem"
                                         Content="{services:LocalizedText Key=UiTechnischeDaten}"
                                         Visibility="Collapsed"/>
                        </ListBox>

                        <StackPanel Grid.Row="3">
                            <Border Style="{StaticResource ConceptNavigationSectionSeparatorStyle}"/>
                            <ListBox x:Name="ConceptUtilityFamilyList"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource ConceptFamilyListItemStyle}"
                                     SelectionChanged="ConceptFamilyList_SelectionChanged"
                                     AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.LowerMetadataGroups}">
                                <ListBoxItem x:Name="ConceptChapterFamilyItem"
                                             Content="{services:LocalizedText Key=UiKapitel}"/>
                                <ListBoxItem x:Name="ConceptPassThroughFamilyItem"
                                             Content="{services:LocalizedText Key=UiPassThrough}"/>
                                <ListBoxItem x:Name="ConceptHelpFamilyItem"
                                             Content="{DynamicResource MetadataHelpNavigation}"/>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Margin="8,16,8,0"
                                    HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox x:Name="ConceptRememberLastGroupCheckBox"
                                          Content="{DynamicResource MetadataNavigationRememberGroup}"
                                          Style="{StaticResource ConceptCompactNavigationCheckBoxStyle}"
                                          Checked="ConceptRememberLastGroupCheckBox_Changed"
                                          Unchecked="ConceptRememberLastGroupCheckBox_Changed"
                                          AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.RememberLastGroup}"/>
                                <controls:InfoPoint Style="{StaticResource ConceptCompactNavigationInfoPointStyle}" Margin="4,0,0,0"
                                                    Title="{DynamicResource MetadataNavigationRememberGroupInfoTitle}"
                                                    Body="{DynamicResource MetadataNavigationRememberGroupInfoBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Content="{DynamicResource MetadataNavigationInputWarning}"
                                          Style="{StaticResource ConceptCompactNavigationCheckBoxStyle}"
                                          IsChecked="{Binding WarnBeforeDiscardingConceptDrafts, Mode=TwoWay}"
                                          ToolTip="{services:LocalizedToolTip Key=MetadataNavigationInputWarningFull}"
                                          AutomationProperties.Name="{DynamicResource MetadataNavigationInputWarningFull}"
                                          AutomationProperties.HelpText="{DynamicResource MetadataNavigationInputWarningFull}"/>
                                <controls:InfoPoint Style="{StaticResource ConceptCompactNavigationInfoPointStyle}" Margin="4,0,0,0"
                                                    Title="{DynamicResource MetadataNavigationInputWarningInfoTitle}"
                                                    Body="{DynamicResource MetadataNavigationInputWarningInfoBody}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{DynamicResource MetadataNavigationTechnicalNames}"
                                          Style="{StaticResource ConceptCompactNavigationCheckBoxStyle}"
                                          IsChecked="{Binding ShowTechnicalFieldNames, Mode=TwoWay}"
                                          AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.ShowTechnicalFieldNames}"/>
                                <controls:InfoPoint Style="{StaticResource ConceptCompactNavigationInfoPointStyle}" Margin="4,0,0,0"
                                                    Title="{DynamicResource MetadataNavigationTechnicalNamesInfoTitle}"
                                                    Body="{DynamicResource MetadataNavigationTechnicalNamesInfoBody}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid x:Name="ConceptEditorColumnMetrics"
                          Height="0"
                          Margin="20,0,20,0"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="ConceptEditorColumnMetric" Width="29*"/>
                            <ColumnDefinition Width="11*"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <ScrollViewer x:Name="ConceptScrollViewer"
                                  Style="{StaticResource ConceptStableVerticalGutterScrollViewerStyle}">
                        <Grid>
                        <Grid x:Name="ConceptQuickAccessPanel"
                              Margin="20"
                              MinWidth="560">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessTitleField"
                                                              Grid.Row="0"/>

                        <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessAlbumField"
                                                              Grid.Row="1"/>

                        <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessAuthorField" Grid.Row="2"/>

                        <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessSpeakerField" Grid.Row="3"/>

                        <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessGenreField" Grid.Row="4"/>

                        <Grid x:Name="ConceptQuickAccessYearIsbnRow" Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29*"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid x:Name="ConceptQuickAccessYearField"
                                      Grid.Column="0"
                                      Margin="0,0,0,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="0"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="ConceptQuickAccessYearLabel"
                                               Grid.Column="0"
                                               Text="{Binding YearLabel}"
                                               Margin="0,4,0,0"
                                               VerticalAlignment="Top"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="2" Text="{Binding YearOriginLabel}" Style="{StaticResource ConceptFieldChromeOriginTextStyle}"/>

                                    <ToggleButton x:Name="ConceptYearOutputToggle"
                                                  Grid.Column="4"
                                                  HorizontalAlignment="Right"
                                                  Style="{StaticResource ConceptOutputChipToggleStyle}"
                                                  IsChecked="{Binding IsYearIncluded, Mode=TwoWay}"
                                                  AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.YearOutputState}"/>
                            </Grid>

                            <Grid x:Name="ConceptYearEditorColumnHost"
                                  Grid.Row="1">
                                    <Border Height="27"
                                            Visibility="{Binding IsYearIncluded, Converter={StaticResource ConceptBooleanToVisibilityConverter}}"
                                            Style="{StaticResource ConceptRoundedInputBorderStyle}">
                                        <Grid>
                                            <TextBlock Text="{x:Static services:MetadataDateParser.YearWatermark}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Opacity="0.62"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, ElementName=ConceptYearTextBox}" Value=""/>
                                                                    <Condition Binding="{Binding IsKeyboardFocused, ElementName=ConceptYearTextBox}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="ConceptYearTextBox" Text="{Binding SpecialDrafts.Year, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="Year"
                                                     MaxLength="4"
                                                     PreviewTextInput="ConceptYearTextBox_PreviewTextInput"
                                                     DataObject.Pasting="ConceptYearTextBox_Pasting"
                                                     PreviewKeyDown="ConceptSingleValueTextBox_PreviewKeyDown"
                                                     VerticalContentAlignment="Center"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource MainTextBrush}"
                                                     BorderThickness="0"
                                                     CaretBrush="{DynamicResource MainTextBrush}"
                                                     Padding="6,1"
                                                     AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.Year}"/>
                                        </Grid>
                                    </Border>
                            </Grid>

                            <ItemsControl x:Name="ConceptYearValuesControl"
                                          Grid.Row="2"
                                          ItemsSource="{Binding YearValues}"
                                          Width="{Binding ActualWidth, ElementName=ConceptYearEditorColumnHost}"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.YearValue}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Margin" Value="0,8,0,0"/>
                                        <Style.Triggers>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsYearIncluded}" Value="False">
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Opacity" Value="0.62"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,6"
                                                HorizontalAlignment="Left"
                                                Tag="Year"
                                                Style="{StaticResource ConceptSingleValueBadgeStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Value}"
                                                           Style="{StaticResource ConceptValueBadgeTextStyle}"
                                                           VerticalAlignment="Center"/>
                                                <Button Tag="Year"
                                                        IsEnabled="{Binding DataContext.IsYearIncluded, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Click="EditSingleValue_Click"
                                                        AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.EditYear}"
                                                        Style="{StaticResource ConceptValueBadgeEditButtonStyle}"/>
                                                <Button Tag="Year"
                                                        Click="RemoveSingleValue_Click"
                                                        AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.RemoveYear}"
                                                        Style="{StaticResource ConceptAuthorBadgeRemoveButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                </Grid>

                                <controls:ConceptMetadataFieldControl x:Name="ConceptQuickAccessIsbnField"
                                                                      Grid.Column="2"
                                                                      UseFullWidth="True"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ConceptQuickAccessSeriesHost" Grid.Row="6" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29*"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>
                            <controls:ConceptSeriesFieldControl x:Name="ConceptQuickAccessSeriesField"
                                                                Grid.Column="0"/>
                        </Grid>

                        <Grid x:Name="ConceptQuickAccessWorkTypeEditionRow"
                              Grid.Row="7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29*"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ConceptQuickAccessWorkTypeField"
                                      Grid.Column="2"
                                      Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="0"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="ConceptQuickAccessWorkTypeLabel"
                                                       Grid.Column="0"
