                                    <TextBlock Text="{DynamicResource CoverDetailsFileNameLabel}" Style="{StaticResource ConceptMetadataContextRoleStyle}"/>
                                    <TextBlock Text="{Binding CoverDetailsFileName}" Style="{StaticResource ConceptMetadataContextValueStyle}" MinHeight="18" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource CoverDetailsFormatLabel}" Style="{StaticResource ConceptMetadataContextRoleStyle}"/>
                                    <TextBlock Text="{Binding CoverDetailsFormat}" Style="{StaticResource ConceptMetadataContextValueStyle}" MinHeight="18"/>
                                    <TextBlock Text="{DynamicResource CoverDetailsDimensionsLabel}" Style="{StaticResource ConceptMetadataContextRoleStyle}"/>
                                    <TextBlock Text="{Binding CoverDetailsDimensions}" Style="{StaticResource ConceptMetadataContextValueStyle}" MinHeight="18"/>
                                    <TextBlock Text="{DynamicResource CoverDetailsFileSizeLabel}" Style="{StaticResource ConceptMetadataContextRoleStyle}"/>
                                    <TextBlock Text="{Binding CoverDetailsFileSize}" Style="{StaticResource ConceptMetadataContextValueStyle}" MinHeight="18"/>
                                    <CheckBox Content="{services:LocalizedText Key=UiCoverOrdnerMerken}"
                                              Margin="0,12,0,0"
                                              Style="{StaticResource SettingsToggleStyle}"
                                              IsChecked="{Binding RememberLastCoverPickerFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.RememberCoverFolder}"/>
                                    <TextBlock Text="{DynamicResource CoverWarningThresholdHeading}"
                                               Style="{StaticResource ConceptMetadataContextRoleStyle}"
                                               Margin="0,12,0,4"
                                               TextWrapping="Wrap"/>
                                    <ComboBox x:Name="ConceptCoverWarningThresholdComboBox"
                                              Style="{StaticResource ConceptMetadataContextInlineComboBoxStyle}"
                                              SelectionChanged="ConceptCoverWarningThresholdComboBox_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ConceptChapterPanel"
                          Visibility="Collapsed"
                          Margin="20,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="29*"/>
                            <ColumnDefinition Width="11*"/>
                            <ColumnDefinition Width="{x:Static presentation:ChapterGridLayoutMetrics.ProposalDisclosureGridLength}"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,20,8,0">
                            <DataGrid x:Name="ConceptChapterGrid"
                                      ItemsSource="{Binding ChapterTracksView}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                      Loaded="ConceptChapterGrid_Loaded"
                                      Unloaded="ConceptChapterGrid_Unloaded"
                                      SizeChanged="ConceptChapterGrid_SizeChanged"
                                      Background="{DynamicResource AppBackgroundBrush}"
                                      Foreground="{DynamicResource MainTextBrush}"
                                      BorderThickness="0"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEmbeddedChapter}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                <Setter Property="Opacity" Value="0.45"/>
                                                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.Columns>
                                    <DataGridTemplateColumn x:Name="ConceptChapterProposalColumn" Header="{services:LocalizedText Key=UiKapitelvorschlag}" Width="180" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{x:Static presentation:ChapterGridLayoutMetrics.ProposalDisclosureGridLength}"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0"
                                                                  IsChecked="{Binding IsChapterDetailsExpanded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  Visibility="{Binding HasEmbeddedChapterDetails, Converter={StaticResource ConceptBooleanToVisibilityConverter}}"
                                                                  AutomationProperties.Name="{Binding ChapterDetailsAutomationName}"
                                                                  Click="ConceptChapterDetailsToggle_Click"
                                                                  Style="{StaticResource ChapterDisclosureToggleStyle}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ChapterProposal}"
                                                               TextTrimming="None"
                                                               TextWrapping="NoWrap"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource DataGridCellInheritedTextStyle}">
                                                                <Setter Property="Margin" Value="{x:Static presentation:ChapterGridLayoutMetrics.ProposalTextMargin}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEmbeddedChapter}" Value="True">
                                                                        <Setter Property="Margin" Value="{x:Static presentation:ChapterGridLayoutMetrics.EmbeddedProposalTextMargin}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn x:Name="ConceptChapterDurationColumn" Header="{services:LocalizedText Key=UiDauer}"
                                                        Binding="{Binding Duration}"
                                                        Width="110"/>
                                    <DataGridTextColumn x:Name="ConceptChapterWarningColumn" Header="{services:LocalizedText Key=UiKapitelwarnung}"
                                                        Binding="{Binding ChapterWarning}"
                                                        Width="260"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="ConceptChapterBottomFade"
                                    Height="50"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="3"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource AppBackgroundBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#66000000" Offset="0.42"/>
                                        <GradientStop Color="#99000000" Offset="0.72"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <ScrollBar x:Name="ConceptChapterHorizontalScrollBar"
                                       Orientation="Horizontal"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       Height="14"
                                       Panel.ZIndex="4"
                                       Visibility="Collapsed"
                                       ValueChanged="ConceptChapterHorizontalScrollBar_ValueChanged"/>
                            <Border x:Name="ConceptChapterRightFade"
                                    Width="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Stretch"
                                    Panel.ZIndex="5"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource AppBackgroundBrush}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/>
                                        <GradientStop Color="#66000000" Offset="0.55"/>
                                        <GradientStop Color="Black" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <Grid Grid.Column="1" Margin="0,20,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <ContentControl Grid.Row="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Content="{Binding CoverPreviewSource}"
                                            ContentTemplate="{StaticResource ConceptMetadataFamilyCoverTemplate}"/>
                            <ScrollViewer x:Name="ConceptChapterSettingsScrollViewer"
                                          Grid.Row="1"
                                          Margin="0,16,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ConceptChapterSettingsEditorPanel">
                                    <TextBlock x:Name="ConceptChapterSettingsHeadingTextBlock"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="ConceptChapterModeLabelTextBlock"
                                               Style="{StaticResource ConceptMetadataContextRoleStyle}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="ConceptChapterModeComboBox" ItemContainerStyle="{StaticResource ChapterModeComboBoxItemStyle}"
                                              Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                              SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                    <StackPanel x:Name="ConceptChapterNumberingStylePanel" Margin="0,10,0,0">
                                        <TextBlock x:Name="ConceptChapterNumberingStyleLabelTextBlock"
                                                   Style="{StaticResource ConceptMetadataContextRoleStyle}"
                                                   Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ConceptChapterNumberingStyleComboBox"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ConceptChapterCustomRulePanel" Margin="0,16,0,0">
                                        <TextBlock x:Name="ConceptChapterCustomHeadingTextBlock"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,8"/>
                                        <ComboBox x:Name="ConceptChapterSlot1ComboBox"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                        <ComboBox x:Name="ConceptChapterSeparator1ComboBox"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                        <ComboBox x:Name="ConceptChapterSlot2ComboBox"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                        <ComboBox x:Name="ConceptChapterSeparator2ComboBox"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                        <ComboBox x:Name="ConceptChapterSlot3ComboBox"
                                                  Margin="0,6,0,0"
                                                  Style="{StaticResource ConceptCompactSettingsComboBoxStyle}"
                                                  SelectionChanged="ConceptChapterSettingsComboBox_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <ScrollBar x:Name="ConceptChapterVerticalScrollBar"
                                   Grid.Column="2"
                                   Orientation="Vertical"
                                   Margin="3,0,5,0"
                                   VerticalAlignment="Stretch"
                                   Visibility="Collapsed"
                                   ValueChanged="ConceptChapterVerticalScrollBar_ValueChanged"/>
                    </Grid>

                    <Border x:Name="ConceptScrollCorner"
                            Width="17"
                            Height="17"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Panel.ZIndex="10"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ComputedHorizontalScrollBarVisibility, ElementName=ConceptScrollViewer}" Value="Visible"/>
                                            <Condition Binding="{Binding ComputedVerticalScrollBarVisibility, ElementName=ConceptScrollViewer}" Value="Visible"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{services:LocalizedText Key=UiSchliessen}"
                            Width="110"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Close_Click"
                            AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.CloseDialog}"/>
                </StackPanel>
            </Border>
    </Grid>
</Window>
