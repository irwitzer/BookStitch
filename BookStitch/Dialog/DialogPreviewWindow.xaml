<Window x:Class="BookStitch.Dialog.DialogPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        Title="Dialogvorschau"
        Icon="/Assets/Icons/BookStitchAppIcon-Simplified-multisize.ico"
        Width="760"
        Height="610"
        MinWidth="660"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="#101418"
        Foreground="#E8EDF2"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BookStitchSliderStyle" TargetType="Slider">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6"
                                        Background="#202830"
                                        BorderBrush="#35414D"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center"
                                       IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Background="{StaticResource AccentBrush}"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="3"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="18">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{StaticResource AccentSoftBrush}"
                                                            BorderBrush="#8CE7EA"
                                                            BorderThickness="1"
                                                            CornerRadius="9"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Background="Transparent"
                                                      BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource PanelBackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="62"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#111820"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,0,0,1"
                    dialog:DialogWindowBehavior.IsDragRegion="True">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dialogvorschau"
                                   Foreground="{StaticResource AccentSoftBrush}"
                                   FontWeight="Bold"
                                   FontSize="18"/>
                        <TextBlock Text="Entwickleransicht – Dialogaktionen nur bewusst ausführen."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">
                    <TextBlock Text="Soundereignisse"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Löst die echten Benachrichtigungsereignisse aus. Profil, Bibliothek und Lautstärke sind dieselben globalen Einstellungen wie im Bereich Sounds."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="CD-Wechsel" Tag="DiscChangeRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="Nutzeraktion nötig" Tag="UserActionRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="Abschluss" Tag="ProjectCompleted" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="Warnung" Tag="Warning" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="Information" Tag="Information" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="Fehler" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                    </WrapPanel>

                    <Border Background="#152027"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Soundprofil" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewSoundProfileComboBox"
                                          Height="32"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="PreviewSoundProfileComboBox_Changed">
                                    <ComboBoxItem Content="Keine Sounds" Tag="Off"/>
                                    <ComboBoxItem Content="Nur CD-Wechsel" Tag="DiscOnly"/>
                                    <ComboBoxItem Content="Wichtige Ereignisse" Tag="Important"/>
                                    <ComboBoxItem Content="Alle Hinweise" Tag="All"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Soundbibliothek" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewSoundLibraryComboBox"
                                          Height="32"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="PreviewSoundLibraryComboBox_Changed">
                                    <ComboBoxItem Content="Sanft" Tag="Gentle"/>
                                    <ComboBoxItem Content="Bass" Tag="Bass"/>
                                    <ComboBoxItem Content="Hammondorgel" Tag="HammondOrgan"/>
                                    <ComboBoxItem Content="Warm" Tag="Warm"/>
                                    <ComboBoxItem Content="Retro" Tag="Retro"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Lautstärke" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PreviewSoundVolumeTextBlock"
                                               Grid.Column="2"
                                               Text="65 %"
                                               Foreground="{StaticResource AccentSoftBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="PreviewSoundVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource BookStitchSliderStyle}"
                                        ValueChanged="PreviewSoundVolumeSlider_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <TextBlock Text="Fokusprofil" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewFocusProfileComboBox"
                                          Height="32"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          SelectionChanged="PreviewFocusProfileComboBox_Changed">
                                    <ComboBoxItem Content="Kein Fokus" Tag="Off"/>
                                    <ComboBoxItem Content="Standard" Tag="Standard"/>
                                    <ComboBoxItem Content="In den Vordergrund" Tag="Foreground"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Verzögerte Fokustests"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Nach dem Klick bleiben vier Sekunden, um zu einem anderen Programm zu wechseln. Danach wird das echte Ereignis mit dem gewählten Fokusprofil ausgelöst."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="Nutzeraktion in 4 s" Tag="UserActionRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                        <Button Content="CD-Wechsel in 4 s" Tag="DiscChangeRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                        <Button Content="Fehler in 4 s" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="DelayedFocusStatusTextBlock"
                               Text="Bereit"
                               Foreground="{StaticResource AccentSoftBrush}"
                               Margin="0,0,0,18"/>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="CD-Wartedialog – Simulation"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Öffnet den echten produktiven Wartedialog mit kontrollierten Testzuständen. Laufwerk, Projekte und Dateien bleiben unberührt. Wartende Zustände werden mit Abbrechen beendet."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="Laufwerk leer" Tag="EmptyDrive" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="Falsche Disc" Tag="UnsupportedDisc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="Duplikat ausgeworfen" Tag="DuplicateEjected" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="Duplikat manuell" Tag="DuplicateManualEject" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="Langsam, dann erkannt" Tag="SlowThenReady" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="Richtige Disc erkannt" Tag="Ready" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                    </WrapPanel>

                    <TextBlock Text="Hybrider Hardwaretest"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,8,0,6"/>
                    <TextBlock Text="Verwendet ein echtes optisches Laufwerk, echten Auswurf, echtes Polling und die produktive Disc-Erkennung. Nach der Erkennung werden weder Import noch Ripping, Konvertierung oder Merge gestartet. Für einen Duplikattest muss die betreffende Disc zu Beginn bereits eingelegt sein."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="MP3-CD erkennen" Tag="Mp3New" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="MP3-CD Duplikat" Tag="Mp3Duplicate" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="Audio-CD erkennen" Tag="AudioNew" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="Audio-CD Duplikat" Tag="AudioDuplicate" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                    </UniformGrid>
                    <TextBlock x:Name="DiscTestStatusTextBlock"
                               Text="CD-Test bereit"
                               Foreground="{StaticResource AccentSoftBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3"/>
                    <TextBlock x:Name="DiscTestProgressTextBlock"
                               Text="Es werden keine Projektdaten verändert."
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="Standardmeldungen"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,18">
                        <Button Content="Information" Tag="Information" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="Warnung" Tag="Warning" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="Fehler" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="Frage" Tag="Question" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="Zahleneingabe" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="InputPreview_Click"/>
                    </WrapPanel>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="Fachdialoge"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MainTextBrush}"
                               Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Content="CD-Laufwerk auswählen" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="DiscSourcePreview_Click"/>
                        <Button Content="Weitere CDs hinzufügen" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="AddDiscsPreview_Click"/>
                        <Button Content="Projekt öffnen" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="ResumeProjectPreview_Click"/>
                        <Button Content="Lokales Projekt vorbereiten" Tag="Folder" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                        <Button Content="MP3-CD-Projekt vorbereiten" Tag="Mp3Disc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                        <Button Content="Audio-CD-Projekt vorbereiten" Tag="AudioDisc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                    </UniformGrid>

                    <Border Background="#152027"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12"
                            Margin="0,10,0,0">
                        <TextBlock Text="Der CD-Wartedialog kann oben simuliert oder mit echter Hardware geprüft werden. Native Windows-Datei- und Ordnerdialoge gehören nicht zur Vorschau."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#151C23"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Button Content="Schließen"
                        Width="110"
                        Height="34"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
