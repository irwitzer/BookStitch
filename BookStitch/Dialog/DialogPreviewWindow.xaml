<Window x:Class="BookStitch.Dialog.DialogPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:BookStitch.Services"
        xmlns:dialog="clr-namespace:BookStitch.Dialog"
        xmlns:controls="clr-namespace:BookStitch.Controls"
        Title="{services:LocalizedText Key=Developer.DialogPreview}"
        Icon="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-OpenBook.ico"
        Width="760"
        Height="610"
        MinWidth="660"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        Style="{StaticResource LargeResizableWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
<Style x:Key="BookStitchSliderStyle" TargetType="Slider">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Grid VerticalAlignment="Center">
                                <Border Height="6"
                                        Background="{DynamicResource ScrollBarTrackBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        VerticalAlignment="Center"/>
                                <Track x:Name="PART_Track"
                                       VerticalAlignment="Center"
                                       IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                      Background="{DynamicResource AccentBrush}"
                                                      BorderThickness="0">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Height="6"
                                                            Background="{TemplateBinding Background}"
                                                            CornerRadius="3"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Width="18" Height="18">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource AccentSoftBrush}"
                                                            BorderBrush="#8CE7EA"
                                                            BorderThickness="1"
                                                            CornerRadius="9"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                      Background="Transparent"
                                                      BorderThickness="0"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="62"/>
        </Grid.RowDefinitions>

        <controls:LargeResizableWindowHeader Grid.Row="0"
                                             Padding="16,0,12,0"
                                             CloseRequested="CloseButton_Click">
            <controls:LargeResizableWindowHeader.TitleContent>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{services:LocalizedText Key=Developer.DialogPreview}"
                               Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"/>
                    <TextBlock Text="{services:LocalizedText Key=Developer.DeveloperViewUseDialogActionsDeliberately}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.TitleContent>
        </controls:LargeResizableWindowHeader>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,18,22,18">
                    <TextBlock Text="{services:LocalizedText Key=DeveloperTools.Navigation.Sounds}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=Developer.TriggersRealNotificationsUsingTheGlobalSound}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="{services:LocalizedText Key=Developer.CDChange}" Tag="DiscChangeRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.UserActionRequired}" Tag="UserActionRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.Completion}" Tag="ProjectCompleted" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.Warning}" Tag="Warning" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.Information}" Tag="Information" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=MainWindow.Status.ErrorLabel}" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="NotificationPreview_Click"/>
                    </WrapPanel>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14"
                            Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="{services:LocalizedText Key=UiEreignisprofil}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewEventProfileComboBox"
                                          Height="32"
                                          Style="{StaticResource AppearanceComboBoxStyle}"
                                          SelectionChanged="PreviewEventProfileComboBox_Changed">
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiNurCDWechsel}" Tag="DiscOnly"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiWichtigeEreignisse}" Tag="Important"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiAlleHinweise}" Tag="All"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="{services:LocalizedText Key=UiSoundbibliothek}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewSoundLibraryComboBox"
                                          Height="32"
                                          Style="{StaticResource AppearanceComboBoxStyle}"
                                          SelectionChanged="PreviewSoundLibraryComboBox_Changed">
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiKeineSounds}" Tag="None"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiSanft}" Tag="Gentle"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiBass}" Tag="Bass"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiHammondorgel}" Tag="HammondOrgan"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiWarm}" Tag="Warm"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiRetro}" Tag="Retro"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{services:LocalizedText Key=UiLautstaerke}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PreviewSoundVolumeTextBlock"
                                               Grid.Column="2"
                                               Text="65 %"
                                               Foreground="{DynamicResource AccentForegroundBrush}"
                                               FontWeight="SemiBold"/>
                                </Grid>
                                <Slider x:Name="PreviewSoundVolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Style="{StaticResource BookStitchSliderStyle}"
                                        ValueChanged="PreviewSoundVolumeSlider_ValueChanged"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,16,0,0">
                                <TextBlock Text="{services:LocalizedText Key=Developer.FocusProfile}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="PreviewFocusProfileComboBox"
                                          Height="32"
                                          Style="{StaticResource AppearanceComboBoxStyle}"
                                          SelectionChanged="PreviewFocusProfileComboBox_Changed">
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiKeinFokus}" Tag="Off"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiStandard}" Tag="Standard"/>
                                    <ComboBoxItem Content="{services:LocalizedText Key=UiInDenVordergrund}" Tag="Foreground"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="{services:LocalizedText Key=Developer.DelayedFocusTests}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=Developer.AfterClickingYouHaveFourSecondsTo}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button Content="{services:LocalizedText Key=Developer.UserActionIn4S}" Tag="UserActionRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.CDChangeIn4S}" Tag="DiscChangeRequired" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.ErrorIn4S}" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="DelayedFocusPreview_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="DelayedFocusStatusTextBlock"
                               Text="{services:LocalizedText Key=Disc.Drive.Ready}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               Margin="0,0,0,18"/>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="{services:LocalizedText Key=Developer.CDWaitingDialogSimulation}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=Developer.OpensTheRealWaitingDialogWithSimulated}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Content="{services:LocalizedText Key=Developer.EmptyDrive}" Tag="EmptyDrive" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.WrongDisc}" Tag="UnsupportedDisc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.DuplicateEjected}" Tag="DuplicateEjected" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.EjectDuplicateManually}" Tag="DuplicateManualEject" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.SlowThenDetected}" Tag="SlowThenReady" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.CorrectDiscDetected}" Tag="Ready" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="SimulatedDiscWaitPreview_Click"/>
                    </WrapPanel>

                    <TextBlock Text="{services:LocalizedText Key=Developer.HybridHardwareTest}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,8,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=Developer.UsesARealDriveEjectionPollingAnd}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="0,0,0,8">
                        <Button Content="{services:LocalizedText Key=Developer.DetectMP3CD}" Tag="Mp3New" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.DuplicateMP3CD}" Tag="Mp3Duplicate" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.DetectAudioCD}" Tag="AudioNew" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.DuplicateAudioCD}" Tag="AudioDuplicate" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="HybridDiscTestPreview_Click"/>
                    </UniformGrid>
                    <TextBlock x:Name="DiscTestStatusTextBlock"
                               Text="{services:LocalizedText Key=Developer.CDTestReady}"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,3"/>
                    <TextBlock x:Name="DiscTestProgressTextBlock"
                               Text="{services:LocalizedText Key=Developer.NoProjectDataIsChanged}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="{services:LocalizedText Key=Developer.StandardMessages}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,18">
                        <Button Content="{services:LocalizedText Key=Developer.Information}" Tag="Information" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.Warning}" Tag="Warning" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="{services:LocalizedText Key=MainWindow.Status.ErrorLabel}" Tag="Error" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.Question}" Tag="Question" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="MessagePreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.NumberInput}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,7" Click="InputPreview_Click"/>
                    </WrapPanel>

                    <Separator Margin="0,0,0,18" Opacity="0.35"/>

                    <TextBlock Text="{services:LocalizedText Key=Developer.WorkflowDialogs}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Content="{services:LocalizedText Key=UiCDLaufwerkAuswaehlen}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="DiscSourcePreview_Click"/>
                        <Button Content="{services:LocalizedText Key=MainWindow.Action.AddDiscs}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="AddDiscsPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.OpenProject}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="ResumeProjectPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=Developer.SetUpLocalProject}" Tag="Folder" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=MainWindow.Setup.Mp3Prepare}" Tag="Mp3Disc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                        <Button Content="{services:LocalizedText Key=MainWindow.Setup.AudioPrepare}" Tag="AudioDisc" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,8" Padding="14,8" Click="ProjectSetupPreview_Click"/>
                    </UniformGrid>

                    <Border Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="12"
                            Margin="0,10,0,0">
                        <TextBlock Text="{services:LocalizedText Key=Developer.TestTheWaitingDialogAboveWithSimulation}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                                BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Button Content="{services:LocalizedText Key=Common.Close}"
                        Width="110"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,18,0"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CloseButton_Click"/>
            </Border>
    </Grid>
</Window>
