<UserControl x:Class="BookStitch.Controls.SettingsFaqControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services"
             xmlns:models="clr-namespace:BookStitch.Models"
             xmlns:controls="clr-namespace:BookStitch.Controls">
            <Grid Margin="22,22,14,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="FaqSidebarBorder" Grid.Column="0" Grid.ColumnSpan="2"
                        Grid.RowSpan="2"
                        Width="176"
                        Height="176"
                        HorizontalAlignment="Left"
                        Margin="3,0,0,0"
                        VerticalAlignment="Top"
                        Padding="16"
                        Style="{StaticResource BrandLogoDisplayBorderStyle}">
                    <Image SizeChanged="FaqSidebarImage_SizeChanged" x:Name="FaqSidebarImage" Source="/BookStitch;component/Assets/Faq/BookMachin Bauplan.png"
                           Style="{StaticResource BrandLogoDisplayImageStyle}"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{services:LocalizedText Key=Settings.Faq.Title}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=Settings.Faq.Subtitle}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MainTextBrush}"
                               LineHeight="22"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="QuestionsComboBox" HorizontalAlignment="Stretch"
                                  Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                  SelectionChanged="QuestionsComboBox_SelectionChanged"
                                  AutomationProperties.Name="{services:LocalizedText Key=Settings.Faq.Subtitle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Question}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
                <ScrollViewer x:Name="AnswerScrollViewer" Grid.Column="2" Grid.Row="1"
                              Margin="0,18,0,0" Padding="0,0,10,0"
                              ScrollChanged="AnswerScrollViewer_ScrollChanged"
                              PreviewMouseWheel="AnswerScrollViewer_PreviewMouseWheel"
                              PreviewKeyDown="AnswerScrollViewer_PreviewKeyDown"
                              Style="{StaticResource ConceptStableVerticalGutterScrollViewerStyle}"
                              AutomationProperties.Name="{Binding SelectedItem.Question, ElementName=QuestionsComboBox}">
                    <StackPanel DataContext="{Binding SelectedItem, ElementName=QuestionsComboBox}">
                        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="20"
                                   FontWeight="SemiBold" Margin="0,0,0,16"
                                   Foreground="{DynamicResource AccentForegroundBrush}"/>
                        <ItemsControl x:Name="AnswerSections" ItemsSource="{Binding Sections}">
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type models:FaqParagraph}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="22"
                                               Margin="0,0,0,14" Foreground="{DynamicResource MainTextBrush}"/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type models:FaqHeading}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"
                                               FontWeight="SemiBold" Margin="0,8,0,14"
                                               Foreground="{DynamicResource AccentForegroundBrush}"/>
                                </DataTemplate>
                                <DataTemplate DataType="{x:Type models:FaqImage}">
                                    <Image Source="{Binding Source}" MaxWidth="{Binding MaxWidth}" Stretch="Uniform"
                                           Margin="0,8,0,16" SizeChanged="AnswerImage_SizeChanged"
                                           AutomationProperties.Name="{Binding Text}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="StretchDirection" Value="DownOnly"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchQuestionWidth}" Value="True">
                                                        <Setter Property="Width" Value="{Binding ActualWidth, ElementName=QuestionsComboBox}"/>
                                                        <Setter Property="StretchDirection" Value="Both"/>
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                        <controls:FaqNarrationControl x:Name="AudibleNarration" Visibility="Collapsed"
                                                      ImageWidth="{Binding ActualWidth, ElementName=QuestionsComboBox}"
                                                      RevealRequested="AudibleNarration_RevealRequested"/>
                        <controls:FaqChatControl x:Name="IconChat" Visibility="Collapsed"
                                                 RevealRequested="IconChat_RevealRequested"
                                                 SendRequested="IconChat_SendRequested"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>
</UserControl>
