<UserControl x:Class="BookStitch.Controls.ConceptSpecialMetadataFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStitch;component/Themes/ConceptDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style x:Key="SetupEnumCandidateStyle" TargetType="ComboBoxItem"
                   BasedOn="{StaticResource ConceptCandidateComboBoxItemStyle}">
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="EnumCandidate_PreviewMouseLeftButtonUp"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,0,0,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{DynamicResource ConceptFieldChromeHeaderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       Style="{DynamicResource ConceptFieldChromeLabelStyle}"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding OriginLabel}"
                       Style="{DynamicResource ConceptFieldChromeOriginTextStyle}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
            <ToggleButton Margin="0,0,8,0"
                          Style="{DynamicResource ConceptMetadataLockToggleStyle}"
                          Visibility="{Binding IsLockable, Converter={StaticResource BoolToVisibility}}"
                          IsChecked="{Binding IsLocked, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding LockToggleAutomationName}"/>
            <ToggleButton
                          HorizontalAlignment="Right"
                          Style="{DynamicResource ConceptOutputChipToggleStyle}"
                          IsEnabled="{Binding CanToggleOutput}"
                          IsChecked="{Binding IsOutputEnabled, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding OutputToggleAutomationName}"/>
            </StackPanel>
        </Grid>

        <Border x:Name="EditorBorder"
                Grid.Row="1"
                Height="27"
                Visibility="{Binding IsEditorVisible, Converter={StaticResource BoolToVisibility}}"
                Style="{DynamicResource ConceptRoundedInputBorderStyle}">
            <Grid>
                <ComboBox x:Name="EnumEditor"
                          AutomationProperties.Name="{Binding Label}"
                          ItemsSource="{Binding Candidates}"
                          ItemTemplate="{DynamicResource ConceptMetadataCandidateTemplate}"
                          ItemContainerStyle="{StaticResource SetupEnumCandidateStyle}"
                          SelectedValuePath="ValueToCommit"
                          SelectedValue="{Binding DraftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsTextSearchEnabled="True"
                          TextSearch.TextPath="DisplayValue"
                          PreviewKeyDown="Editor_PreviewKeyDown"
                          Style="{DynamicResource ConceptComboBoxStyle}"/>
                <TextBlock x:Name="YearWatermark"
                           Text="{x:Static services:MetadataDateParser.YearWatermark}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Opacity="0.62"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsYear}" Value="True"/>
                                        <Condition Binding="{Binding DraftText}" Value=""/>
                                        <Condition Binding="{Binding IsKeyboardFocused, ElementName=YearEditor}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBox x:Name="YearEditor"
                         AutomationProperties.Name="{Binding Label}"
                         Text="{Binding DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         MaxLength="4"
                         PreviewTextInput="YearEditor_PreviewTextInput"
                         PreviewKeyDown="Editor_PreviewKeyDown"
                         VerticalContentAlignment="Center"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6,1"/>
            </Grid>
        </Border>

        <ItemsControl x:Name="ValueBadges"
                      Grid.Row="2"
                      ItemsSource="{Binding Values}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="Margin" Value="0,8,0,0"/>
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOutputEnabled}" Value="False">
                            <Setter Property="Opacity" Value="0.62"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,6,4"
                            Padding="8,3"
                            MouseLeftButtonDown="Badge_MouseLeftButtonDown"
                            Style="{DynamicResource ConceptValueBadgeStyle}">
                        <DockPanel>
                            <TextBlock Text="{Binding Value}"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource ConceptValueBadgeTextStyle}"/>
                            <Button Content="✎"
                                    IsEnabled="{Binding DataContext.CanEditValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Margin="6,0,0,0"
                                    Click="EditValue_Click"
                                    Style="{DynamicResource ConceptValueBadgeEditButtonStyle}"/>
                            <Button Content="×"
                                    IsEnabled="{Binding DataContext.CanRemoveValues, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Click="RemoveValue_Click"
                                    Style="{DynamicResource ConceptValueBadgeRemoveButtonStyle}"/>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
