<UserControl x:Class="BookStitch.Controls.FaqNarrationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Button x:Name="PlaybackButton" HorizontalAlignment="Right" Width="36" Margin="0,0,0,12"
                Style="{StaticResource SettingsSecondaryButtonStyle}" Click="PlaybackButton_Click">
            <Path x:Name="PlaybackGlyph" Width="12" Height="12" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Button>
        <TextBlock x:Name="NarrationText" TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,14"
                   Foreground="{DynamicResource MainTextBrush}"/>
        <Image x:Name="FinalImage" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,16"
               Visibility="Collapsed" Opacity="0" SizeChanged="FinalImage_SizeChanged"/>
    </StackPanel>
</UserControl>
