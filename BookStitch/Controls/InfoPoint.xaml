<UserControl x:Class="BookStitch.Controls.InfoPoint"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStitch.Controls"
             Focusable="False"
             PreviewKeyDown="InfoPoint_PreviewKeyDown">
    <Grid>
        <ToggleButton x:Name="InfoButton"
                      Width="16"
                      Height="16"
                      Margin="0"
                      Padding="0"
                      Focusable="True"
                      FocusVisualStyle="{DynamicResource BookStitchKeyboardFocusVisualStyle}"
                      Background="Transparent"
                      BorderThickness="0"
                      Click="InfoButton_Click"
                      MouseEnter="InfoButton_MouseEnter"
                      MouseLeave="InfoButton_MouseLeave"
                      AutomationProperties.Name="{Binding Title, ElementName=Root}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="16" Height="16" Background="Transparent">
                        <Grid Width="16" Height="16"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{Binding IconScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                ScaleY="{Binding IconScale, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                            </Grid.RenderTransform>
                        <Ellipse x:Name="InfoCircle"
                                 Width="14"
                                 Height="14"
                                 Stroke="{DynamicResource InfoIconBorderBrush}"
                                 StrokeThickness="1.2"
                                 Fill="Transparent"/>
                        <TextBlock x:Name="InfoGlyph"
                                   Text="i"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InfoIconGlyphBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,-1,0,0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="OnPrimary">
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoOnPrimaryIconBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoOnPrimaryIconGlyphBrush}"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="OnPrimary"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoOnPrimaryIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoOnPrimaryIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="OnPrimary"/>
                                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoOnPrimaryIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoOnPrimaryIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="OnPrimary"/>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoOnPrimaryIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoOnPrimaryIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="Default"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="Default"/>
                                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type controls:InfoPoint}}}" Value="Default"/>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="InfoCircle" Property="Stroke" Value="{DynamicResource InfoIconHoverBorderBrush}"/>
                            <Setter TargetName="InfoGlyph" Property="Foreground" Value="{DynamicResource InfoIconHoverGlyphBrush}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="InfoPopup"
               PlacementTarget="{Binding ElementName=InfoButton}"
               Placement="Custom"
               CustomPopupPlacementCallback="InfoPopup_CustomPopupPlacement"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Opened="InfoPopup_Opened"
               Closed="InfoPopup_Closed">
            <Border Background="{DynamicResource InfoPopupBackgroundBrush}"
                    BorderBrush="{DynamicResource InfoPopupBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="11,9"
                    Margin="3"
                    MaxWidth="380"
                    MouseEnter="InfoPopup_MouseEnter"
                    MouseLeave="InfoPopup_MouseLeave">
                <StackPanel>
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InfoPopupForegroundBrush}"
                               Margin="0,0,0,5"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Body, ElementName=Root}"
                               Foreground="{DynamicResource InfoPopupForegroundBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
