<UserControl x:Class="BookStitch.Controls.SettingsInfoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services">
        <ScrollViewer Style="{StaticResource DialogInsetScrollViewerStyle}"
                      Padding="22,22,14,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="InfoSidebarBorder" Grid.Column="0" Grid.ColumnSpan="2"
                        Width="176"
                        Height="176"
                        HorizontalAlignment="Left"
                        Margin="3,0,0,0"
                        VerticalAlignment="Top"
                        Padding="0"
                        Style="{StaticResource BrandLogoDisplayBorderStyle}">
                    <Image x:Name="InfoSidebarImage" SizeChanged="InfoSidebarImage_SizeChanged" Source="{DynamicResource InfoSquareImageSource}"
                           Style="{StaticResource BrandLogoDisplayImageStyle}"
                           Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{services:LocalizedText Key=UiBookStitch}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentForegroundBrush}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{services:LocalizedText Key=UiWindowsAnwendungZumErstellenVollstaendigerHo}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MainTextBrush}"
                               LineHeight="22"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="InfoVersionTextBlock"
                               Text="{services:LocalizedText Key=UiVersion}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{services:LocalizedText Key=UiEntwickeltVon}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Button x:Name="DeveloperNameButton" Content="{services:LocalizedText Key=UiIrwitzer}"
                                Foreground="{DynamicResource AccentForegroundBrush}"
                                Style="{StaticResource HiddenTextButtonStyle}"
                                AutomationProperties.Name="{services:LocalizedText Key=UiIrwitzer}"
                                Click="DeveloperName_Click"/>
                    </StackPanel>
                    <TextBlock Text="{services:LocalizedText Key=UiLizenzGNUGeneralPublicLicenseV30OnlyGPL30Onl}"
                               Foreground="{DynamicResource MainTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Separator Margin="0,0,0,16" Opacity="0.35"/>

                    <TextBlock Text="{services:LocalizedText Key=UiProjektUndVeroeffentlichungen}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{services:LocalizedText Key=UiProjektinformationenVeroeffentlichungenUndQu}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               LineHeight="22"
                               Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{services:LocalizedText Key=UiGitHubProjektOeffnen}"
                                MinWidth="170"
                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                Click="OpenGitHubProject_Click"
                                Margin="0,0,10,0"/>
                        <Button Grid.Column="1" Content="{services:LocalizedText Key=UiDrittanbieterhinweiseOeffnen}"
                                MinWidth="220"
                                Style="{StaticResource SettingsSecondaryButtonStyle}"
                                Click="OpenThirdPartyNotices_Click"/>
                        <ComboBox x:Name="DeveloperVisibilityComboBox" Grid.Column="2" Margin="10,0,0,0" MinWidth="140"
                                  HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectedValue="{Binding VisibilityChoice, Source={x:Static services:DeveloperToolsCommands.AccessState}, Mode=TwoWay}"
                                  AutomationProperties.Name="{services:LocalizedText Key=DeveloperAccess.Visibility}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource AppearanceCompactComboBoxStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelectorAvailable, Source={x:Static services:DeveloperToolsCommands.AccessState}}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBoxItem Content="{services:LocalizedText Key=DeveloperAccess.Show}" Tag="{x:Static services:DeveloperToolsVisibilityChoice.Show}"/>
                            <ComboBoxItem Content="{services:LocalizedText Key=DeveloperAccess.Hide}" Tag="{x:Static services:DeveloperToolsVisibilityChoice.Hide}"/>
                            <ComboBoxItem Content="{services:LocalizedText Key=DeveloperAccess.Conceal}" Tag="{x:Static services:DeveloperToolsVisibilityChoice.Conceal}">
                                <ComboBoxItem.Style>
                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanConceal, Source={x:Static services:DeveloperToolsCommands.AccessState}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBoxItem.Style>
                            </ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <StackPanel x:Name="ZeroBullshitPanel" Margin="0,8,0,0">
                        <Image Source="/BookStitch;component/Assets/Icons/BookStitch-Heart-Petrol.png"
                               Width="48.24" Height="48.24" HorizontalAlignment="Center" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="{services:LocalizedText Key=Settings.Info.ZeroBullshit}"
                                   FontSize="11.39" FontWeight="SemiBold" TextAlignment="Center"
                                   Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,4,0,8"/>
                        <TextBlock Text="{services:LocalizedText Key=Settings.Info.ZeroBullshitDescription}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{DynamicResource MainTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
</UserControl>
