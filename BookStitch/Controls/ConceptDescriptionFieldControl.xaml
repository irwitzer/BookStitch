<UserControl x:Class="BookStitch.Controls.ConceptDescriptionFieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services"
             xmlns:controls="clr-namespace:BookStitch.Controls"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BookStitch;component/Themes/ConceptDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ConceptBooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="11*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="DescriptionHeaderContent" Grid.Column="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type controls:ConceptDescriptionFieldControl}}}" Value="Stretch">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding DescriptionLabel}"
                           Margin="0,4,0,0"
                           VerticalAlignment="Top"
                           FontWeight="SemiBold"/>
                <Button x:Name="MinimalEditorToggleButton"
                        Grid.Column="1"
                        Content="+"
                        Margin="4,0,0,0"
                        PreviewMouseLeftButtonDown="MinimalEditorToggleButton_PreviewMouseLeftButtonDown"
                        Click="MinimalEditorToggleButton_Click"
                        AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.DescriptionOpenEditor}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ConceptMinimalEditorToggleButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Minimal">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Grid.Column="2"
                           Text="{Binding DescriptionOriginLabel}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource ConceptFieldChromeOriginTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Minimal">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ToggleButton Grid.Column="4"
                              HorizontalAlignment="Right"
                              Style="{StaticResource ConceptOutputChipToggleStyle}"
                              IsChecked="{Binding IsDescriptionIncluded, Mode=TwoWay}"
                              AutomationProperties.Name="{services:LocalizedText Key=Metadata.Automation.DescriptionOutputState}"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="11*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DescriptionEditorBorder"
                    Grid.Column="0"
                    VerticalAlignment="Stretch">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ConceptRoundedInputBorderStyle}">
                        <Setter Property="Visibility" Value="{Binding IsDescriptionIncluded, Converter={StaticResource ConceptBooleanToVisibilityConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Stretch">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Minimal">
                                <Setter Property="Grid.ColumnSpan" Value="2"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Minimal"/>
                                    <Condition Binding="{Binding IsMinimalEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type controls:ConceptDescriptionFieldControl}}}" Value="True"/>
                                    <Condition Binding="{Binding IsDescriptionIncluded}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox x:Name="DescriptionTextBox"
                         Text="{Binding DescriptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         LostFocus="DescriptionTextBox_LostFocus"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         Background="Transparent"
                         Foreground="{DynamicResource MainTextBrush}"
                         BorderThickness="0"
                         CaretBrush="{DynamicResource MainTextBrush}"
                         Padding="6,4"
                         AutomationProperties.Name="{services:LocalizedText Key=Metadata.Field.Description}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="MinLines" Value="10"/>
                            <Setter Property="MaxLines" Value="10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Stretch">
                                    <Setter Property="MinLines" Value="1"/>
                                    <Setter Property="MaxLines" Value="2147483647"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PresentationMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="Minimal">
                                    <Setter Property="MinLines" Value="1"/>
                                    <Setter Property="MaxLines" Value="2147483647"/>
                                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
        </Grid>
    </Grid>
</UserControl>
