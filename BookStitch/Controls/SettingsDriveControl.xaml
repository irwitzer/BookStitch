<UserControl x:Class="BookStitch.Controls.SettingsDriveControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services">
        <ScrollViewer Style="{StaticResource DialogInsetScrollViewerStyle}">
            <StackPanel>
                <TextBlock Text="{services:LocalizedText Key=UiDriveCircle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MainTextBrush}"
                           Margin="0,0,0,14"/>

                <StackPanel Margin="0,0,0,22">
                    <CheckBox x:Name="ExperimentalDriveRoundEnabledCheckBox"
                              Content="{services:LocalizedText Key=UiDriveCircleFuerCDProjekteAktivieren}"
                              Style="{StaticResource SettingsToggleStyle}"
                              Checked="ExperimentalDriveRoundEnabledCheckBox_Changed"
                              Unchecked="ExperimentalDriveRoundEnabledCheckBox_Changed"/>

                    <TextBlock Text="{services:LocalizedText Key=Settings.DriveCircle.Overview}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" LineHeight="21" Margin="0,7,0,18"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <StackPanel x:Name="DiscDriveSlotPanel"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Left"
                                       AllowDrop="True"
                                       PreviewDragOver="DriveRoundSlotPanel_PreviewDragOver"
                                       Drop="DiscDriveSlotPanel_Drop"
                                       DragLeave="DiscDriveSlotPanel_DragLeave"
                                       Margin="0,0,0,8"/>

                            <Button x:Name="DriveRoundUpdateButton"
                                       Content="{services:LocalizedText Key=Settings.Drive.Refresh}"
                                       Width="240"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,7"
                                       Style="{StaticResource SettingsSecondaryButtonStyle}"
                                       Click="DriveRoundUpdate_Click"/>
                            <Button x:Name="DriveRoundRefreshButton"
                                       Content="{services:LocalizedText Key=Settings.Drive.Reset}"
                                       Width="240"
                                       HorizontalAlignment="Left"
                                       Style="{StaticResource SettingsSecondaryButtonStyle}"
                                       Click="DriveRoundRefresh_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" LineHeight="21" Margin="0,0,0,12">
                                <Run FontWeight="SemiBold" Text="{services:LocalizedText Key=Settings.DriveCircle.Order.Label}"/><Run Text=" "/><Run Text="{services:LocalizedText Key=Settings.DriveCircle.Order.Help}"/><LineBreak/>
                                <Run FontWeight="SemiBold" Text="{services:LocalizedText Key=Settings.DriveCircle.Rename.Label}"/><Run Text=" "/><Run Text="{services:LocalizedText Key=Settings.DriveCircle.Rename.Help}"/><LineBreak/>
                                <Run FontWeight="SemiBold" Text="{services:LocalizedText Key=Settings.DriveCircle.Actions.Label}"/><Run Text=" "/><Run Text="{services:LocalizedText Key=Settings.DriveCircle.Actions.Help}"/>
                            </TextBlock>
                            <Border Height="1" Background="{DynamicResource MutedTextBrush}" Opacity="0.35" Margin="0,6,0,18"/>
                            <TextBlock x:Name="DiscDriveRoundHintTextBlock"
                                       Text="{services:LocalizedText Key=UiKeineCDDVDLaufwerkeErkannt}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{services:LocalizedText Key=Settings.DriveCircle.ProjectStart}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" LineHeight="21" Margin="0,18,0,12"/>
                    <TextBlock Text="{services:LocalizedText Key=Settings.DriveCircle.DiscHandling}" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" LineHeight="21"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
</UserControl>
