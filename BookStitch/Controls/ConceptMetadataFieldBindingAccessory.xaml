<UserControl x:Class="BookStitch.Controls.ConceptMetadataFieldBindingAccessory"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BookStitch.Controls"
             Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <controls:InfoPoint Margin="0,0,5,0"
                            Title="{Binding InfoTitle, ElementName=Root}"
                            Body="{Binding InfoBody, ElementName=Root}"/>
        <ToggleButton x:Name="BindingToggle"
                      Content="{Binding Label, ElementName=Root}"
                      Style="{DynamicResource ConceptSpecialFunctionChipToggleStyle}"
                      IsChecked="{Binding BindingState.IsActive, ElementName=Root, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Label, ElementName=Root}"
                      AutomationProperties.HelpText="{Binding InfoBody, ElementName=Root}"/>
    </StackPanel>
</UserControl>
