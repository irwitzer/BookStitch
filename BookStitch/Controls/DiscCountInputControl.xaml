<UserControl x:Class="BookStitch.Controls.DiscCountInputControl"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:BookStitch.Services" Focusable="False">
 <UserControl.Resources>
  <Style x:Key="DiscCountTextStyle" TargetType="TextBox" BasedOn="{StaticResource AppearanceCompactTextBoxStyle}">
   <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
 </UserControl.Resources>
 <Grid PreviewMouseWheel="Input_MouseWheel">
  <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <TextBox x:Name="Input" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2"
   HorizontalContentAlignment="Center" Style="{StaticResource DiscCountTextStyle}"
   PreviewTextInput="Input_PreviewTextInput" PreviewKeyDown="Input_KeyDown" DataObject.Pasting="Input_Pasting"
   AutomationProperties.Name="{services:LocalizedText Key=UiAnzahlCDs}"/>
  <RepeatButton x:Name="IncreaseButton" Grid.Column="1" Content="▲" Style="{StaticResource StepperRepeatButtonStyle}" Margin="4,0,0,10" Click="Increase_Click" AutomationProperties.Name="{services:LocalizedText Key=Disc.Count.Increase}"/>
  <RepeatButton x:Name="DecreaseButton" Grid.Column="2" Content="▼" Style="{StaticResource StepperRepeatButtonStyle}" Margin="4,0,0,10" Click="Decrease_Click" AutomationProperties.Name="{services:LocalizedText Key=Disc.Count.Decrease}"/>
 </Grid>
</UserControl>
