<UserControl x:Class="BookStitch.Controls.SettingsTagsChaptersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:BookStitch.Services"
             xmlns:controls="clr-namespace:BookStitch.Controls">
        <ScrollViewer Style="{StaticResource DialogInsetScrollViewerStyle}">
            <Grid>
                <StackPanel x:Name="MetadataSettingsSection">
                    <TextBlock Text="{services:LocalizedText Key=UiDateiname}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="{StaticResource SettingsFormMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{services:LocalizedText Key=UiUnterordnerImAusgabeordner}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="OutputFolderLayoutComboBox"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="OutputFolderLayoutComboBox_Changed">
                                <ComboBoxItem Content="{services:LocalizedText Key=UiKeinenOrdnerErstellen}" Tag="None"/>
                                <ComboBoxItem Content="{services:LocalizedText Key=UiNurAutor}" Tag="Author"/>
                                <ComboBoxItem Content="{services:LocalizedText Key=UiNurTitel}" Tag="Title"/>
                                <ComboBoxItem Content="{services:LocalizedText Key=UiAutorTitel}" Tag="AuthorTitleNested"/>
                                <ComboBoxItem Content="{services:LocalizedText Key=UiAutorAlbumTitel}" Tag="AuthorAlbumTitleNested"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{services:LocalizedText Key=UiDateinamenschema}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="FileNameTemplateComboBox"
                                      IsEditable="True"
                                      MinWidth="260"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="FileNameTemplateComboBox_Changed"
                                      LostFocus="FileNameTemplateComboBox_LostFocus">
                                <ComboBoxItem Content="{}{Autor} - {Titel}"/>
                                <ComboBoxItem Content="{}{Titel} - {Autor}"/>
                                <ComboBoxItem Content="{}{Titel}"/>
                                <ComboBoxItem Content="{}{Autor} - {Sprecher} - {Titel}"/>
                                <ComboBoxItem Content="{}{Autor} - {Album} - {Titel}"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{services:LocalizedText Key=UiStandardEndung}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="OutputExtensionComboBox"
                                      HorizontalAlignment="Left"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="OutputExtensionComboBox_Changed">
                                <ComboBoxItem Content=".m4a"/>
                                <ComboBoxItem Content=".m4b"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="OutputFolderPreviewTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"
                               Margin="110,0,0,8"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="110,0,0,18">
                        <CheckBox x:Name="OverwriteWithoutAskingCheckBox"
                                  Content="{services:LocalizedText Key=UiZieldateiUeberschreiben}"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Checked="OverwriteWithoutAskingCheckBox_Changed"
                                  Unchecked="OverwriteWithoutAskingCheckBox_Changed"/>
                        <controls:InfoPoint x:Name="OverwriteWithoutAskingInfoPoint"
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Title="{DynamicResource InfoOverwriteFinalOutputTitle}"
                                            Body="{DynamicResource InfoOverwriteFinalOutputBody}"/>
                    </StackPanel>

                    <TextBlock Text="{services:LocalizedText Key=Settings.Genres.Title}"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}" Margin="0,22,0,14"/>
                    <Grid Margin="110,0,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox x:Name="GenreLibraryTagsCheckBox" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  Content="{services:LocalizedText Key=Settings.Genres.LibraryTags}"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Checked="GenreLibraryTags_Changed" Unchecked="GenreLibraryTags_Changed"/>
                        <CheckBox x:Name="GenreCategoriesCheckBox" Grid.Row="1" HorizontalAlignment="Left" Margin="0,8,0,0"
                                  Content="{services:LocalizedText Key=Settings.Genres.Categories}"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Checked="GenreCategories_Changed" Unchecked="GenreCategories_Changed"/>
                        <CheckBox x:Name="GenreEnglishCheckBox" Grid.Row="2" HorizontalAlignment="Left" Margin="0,8,0,0"
                                  Content="{services:LocalizedText Key=Settings.Genres.AlwaysEnglish}"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Checked="GenreEnglish_Changed" Unchecked="GenreEnglish_Changed"/>
                        <CheckBox x:Name="PrivateGenresCheckBox" Grid.Row="3" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed"
                                  Content="{services:LocalizedText Key=Settings.Genres.Private}"
                                  Style="{StaticResource SettingsToggleStyle}"
                                  Checked="PrivateGenres_Changed" Unchecked="PrivateGenres_Changed"/>
                        <ComboBox x:Name="GenreListPreviewComboBox" Grid.Column="2" Width="260" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                  AutomationProperties.Name="{services:LocalizedText Key=Settings.Genres.Title}"/>
                    </Grid>

                    <TextBlock Text="{services:LocalizedText Key=UiCover}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,22,0,14"/>

                    <StackPanel HorizontalAlignment="Left" Margin="110,0,0,0">
                        <TextBlock x:Name="CoverWarningThresholdHeadingTextBlock"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="CoverWarningThresholdComboBox"
                                  HorizontalAlignment="Left"
                                  Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                  controls:ComboBoxContentWidth.IsEnabled="True"
                                  SelectionChanged="CoverWarningThresholdComboBox_Changed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <CheckBox x:Name="RememberLastCoverPickerFolderCheckBox"
                                      Content="{services:LocalizedText Key=UiCoverOrdnerMerken}"
                                      Style="{StaticResource SettingsToggleStyle}"
                                      Checked="RememberLastCoverPickerFolderCheckBox_Changed"
                                      Unchecked="RememberLastCoverPickerFolderCheckBox_Changed"/>
                            <controls:InfoPoint x:Name="RememberLastCoverPickerFolderInfoPoint"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Title="{DynamicResource InfoRememberCoverFolderTitle}"
                                                Body="{DynamicResource InfoRememberCoverFolderBody}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ChaptersSettingsSection" Visibility="Collapsed">
                    <TextBlock x:Name="ChapterSettingsHeadingTextBlock"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MainTextBrush}"
                               Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,18" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="ChapterModeLabelTextBlock" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ChapterModeComboBox" ItemContainerStyle="{StaticResource ChapterModeComboBoxItemStyle}"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="ChapterSettingsComboBox_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="ChapterNumberingStyleLabelTextBlock" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ChapterNumberingStyleComboBox"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="ChapterSettingsComboBox_Changed"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock x:Name="ChapterPreviewDataSourceLabelTextBlock" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ChapterPreviewDataSourceComboBox"
                                      Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                      controls:ComboBoxContentWidth.IsEnabled="True"
                                      SelectionChanged="ChapterSettingsComboBox_Changed"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ChapterCustomSettingsPanel"
                                Margin="0,0,0,18">
                            <TextBlock x:Name="ChapterCustomHeadingTextBlock"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MainTextBrush}"
                                       Margin="0,0,0,10"/>

                            <Grid HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox x:Name="ChapterSlot1ComboBox" Grid.Column="0"
                                          Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                          controls:ComboBoxContentWidth.IsEnabled="True"
                                          SelectionChanged="ChapterSettingsComboBox_Changed"/>
                                <ComboBox x:Name="ChapterSeparator1ComboBox" Grid.Column="1" Margin="8,0,0,0"
                                          Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                          SelectionChanged="ChapterSettingsComboBox_Changed"/>
                                <ComboBox x:Name="ChapterSlot2ComboBox" Grid.Column="2" Margin="8,0,0,0"
                                          Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                          controls:ComboBoxContentWidth.IsEnabled="True"
                                          SelectionChanged="ChapterSettingsComboBox_Changed"/>
                                <ComboBox x:Name="ChapterSeparator2ComboBox" Grid.Column="3" Margin="8,0,0,0"
                                          Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                          SelectionChanged="ChapterSettingsComboBox_Changed"/>
                                <ComboBox x:Name="ChapterSlot3ComboBox" Grid.Column="4" Margin="8,0,0,0"
                                          Style="{StaticResource AppearanceCompactComboBoxStyle}"
                                          controls:ComboBoxContentWidth.IsEnabled="True"
                                          SelectionChanged="ChapterSettingsComboBox_Changed"/>
                            </Grid>
                    </StackPanel>

                    <Border Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,7">
                        <TextBlock x:Name="ChapterPreviewTextBlock"
                                   LineHeight="22"
                                   Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
</UserControl>
