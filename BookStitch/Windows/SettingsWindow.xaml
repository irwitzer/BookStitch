<Window x:Class="BookStitch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BookStitch.Controls"
        xmlns:services="clr-namespace:BookStitch.Services"
        Title="{services:LocalizedText Key=UiEinstellungen}"
        Icon="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-OpenBook.ico"
        Width="1030"
        Height="650"
        MinWidth="1030"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="SettingsWindow_KeyDown"
        Foreground="{DynamicResource MainTextBrush}"
        FontFamily="Segoe UI"
        Style="{StaticResource LargeResizableWindowStyle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:LargeResizableWindowHeader Grid.Row="0"
                                             Padding="14,0,8,0"
                                             CloseRequested="Close_Click">
            <controls:LargeResizableWindowHeader.TitleContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{services:LocalizedText Key=UiEinstellungen}"
                           Style="{StaticResource LargeResizableWindowHeaderTitleTextStyle}"/>
                    <Button Width="34"
                        Margin="6,0,0,0"
                        Style="{StaticResource DeveloperToolsButtonStyle}"
                        AutomationProperties.Name="{services:LocalizedText Key=AutomationOpenDeveloperTools}"
                        Command="{x:Static services:DeveloperToolsCommands.OpenDeveloperToolsWindow}"
                        IsTabStop="False"/>
                </StackPanel>
            </controls:LargeResizableWindowHeader.TitleContent>

        </controls:LargeResizableWindowHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource NavigationDialogNavigationHostStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{services:LocalizedText Key=UiKategorie}"
                               Margin="8,0,8,8"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <ListBox Grid.Row="1" VerticalAlignment="Top" x:Name="SettingsNavigationList"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource NavigationDialogListStyle}"
                             ItemContainerStyle="{StaticResource NavigationDialogItemStyle}"
                             SelectionChanged="SettingsNavigationList_SelectionChanged"
                             AutomationProperties.Name="{services:LocalizedText Key=UiKategorie}">
                        <ListBoxItem Tag="General" Content="{services:LocalizedText Key=UiAllgemein}"/>
                        <ListBoxItem Tag="Conversion" Content="{services:LocalizedText Key=Settings.Conversion.Title}"/>
                        <ListBoxItem Tag="Metadata" Content="{services:LocalizedText Key=UiMetadaten}"/>
                        <ListBoxItem Tag="Chapters" Content="{services:LocalizedText Key=UiKapitel}"/>
                        <ListBoxItem Tag="ProjectManagement" Content="{services:LocalizedText Key=UiProjektverwaltung}"/>
                        <ListBoxItem Tag="Drive" Content="{services:LocalizedText Key=UiLaufwerke}"/>
                    </ListBox>
                    <StackPanel Grid.Row="2">
                        <Border Style="{StaticResource ConceptNavigationSectionSeparatorStyle}"/>
                        <ListBox x:Name="SettingsUtilityNavigationList"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource NavigationDialogListStyle}"
                                 ItemContainerStyle="{StaticResource NavigationDialogItemStyle}"
                                 SelectionChanged="SettingsNavigationList_SelectionChanged"
                                 AutomationProperties.Name="{services:LocalizedText Key=UiKategorie}">
                        <ListBoxItem Tag="Language" Content="{services:LocalizedText Key=LanguageHeading}"
                                     AutomationProperties.Name="{services:LocalizedText Key=LanguageHeading}">
                            <ListBoxItem.ContentTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <ContentControl x:Name="LanguageNavigationIcon" Grid.Column="1" Width="24" Height="20" Margin="8,0,0,0"
                                                        ContentTemplate="{StaticResource LanguageSymbolTemplate}"
                                                        Focusable="False" IsHitTestVisible="False"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBoxItem.ContentTemplate>
                        </ListBoxItem>
                            <ListBoxItem Tag="Info" Content="{services:LocalizedText Key=UiInfo}"/>
                            <ListBoxItem Tag="FAQ" Content="{services:LocalizedText Key=Settings.Faq.NavigationTitle}"/>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource NavigationDialogContentHostStyle}" Padding="0">
                <Grid x:Name="SettingsContentHost">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </Grid.Style>
                    <controls:SettingsGeneralControl x:Name="GeneralSettingsControl"/>
                    <controls:SettingsConversionControl x:Name="ConversionSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsLanguageControl x:Name="LanguageSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsProjectManagementControl x:Name="ProjectManagementSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsTagsChaptersControl x:Name="TagsChaptersSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsDriveControl x:Name="DriveSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsInfoControl x:Name="InfoSettingsControl" Visibility="Collapsed"/>
                    <controls:SettingsFaqControl x:Name="FaqSettingsControl" Visibility="Collapsed"/>
                </Grid>
            </Border>

        </Grid>

        <controls:LargeResizableWindowFooter Grid.Row="2">
            <controls:LargeResizableWindowFooter.RightContent>
                <Button Content="{services:LocalizedText Key=UiSchliessen}"
                        MinWidth="100"
                        Style="{StaticResource SettingsSecondaryButtonStyle}"
                        Click="Close_Click"/>
            </controls:LargeResizableWindowFooter.RightContent>
        </controls:LargeResizableWindowFooter>
    </Grid>
</Window>
