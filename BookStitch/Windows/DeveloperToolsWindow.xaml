                                            Tag="DiscChangeRequired"
                                            MinWidth="150"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            Padding="10,0"
                                            Click="DelayedFocusPreview_Click" />
