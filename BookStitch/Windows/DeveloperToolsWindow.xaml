                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto"
                                        MinHeight="320"
                                        Padding="9"
                                        Foreground="{DynamicResource MainTextBrush}"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        AutomationProperties.Name="{services:LocalizedText Key=Developer.MetadataDecisionAndSourceEvidence}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
