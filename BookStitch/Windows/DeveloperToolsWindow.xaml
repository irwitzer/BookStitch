                                    <TextBlock Text="{services:LocalizedText Key=Developer.PerformanceDiagnostics}"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentForegroundBrush}"
                                        Margin="0,0,0,14" />
                                    <CheckBox x:Name="PerformanceDiagnosticsEnabledCheckBox"
                                        Content="{services:LocalizedText Key=Developer.EnablePerformanceDiagnostics}"
                                        Foreground="{DynamicResource MainTextBrush}"
                                        FontWeight="SemiBold"
                                        Checked="PerformanceDiagnosticsEnabledCheckBox_Changed"
                                        Unchecked="PerformanceDiagnosticsEnabledCheckBox_Changed" />
