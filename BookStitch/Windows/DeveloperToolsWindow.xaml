                                                    MinWidth="150"
                                                    Tag="DuplicateEjected"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Margin="0,0,8,8"
                                                    Padding="10,0"
                                                    Click="SimulatedDiscWaitPreview_Click" />
