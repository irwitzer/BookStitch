                                    <TextBlock Text="{services:LocalizedText Key=Developer.LiveMeasurements}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Margin="0,0,0,8" />
                                    <TextBlock Text="{services:LocalizedText Key=Developer.ReservedForLiveOperationPhaseAndTiming}"
                                        TextWrapping="Wrap"
                                        Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
