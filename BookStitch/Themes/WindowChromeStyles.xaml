<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:BookStitch.Services"
                    xmlns:controls="clr-namespace:BookStitch.Controls"
                    xmlns:dialog="clr-namespace:BookStitch.Dialog"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <Style x:Key="RoundedDialogListBoxStyle" TargetType="ListBox">
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Focusable="False" Padding="0"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeResizableWindowResizeGripStyle" TargetType="ResizeGrip">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,2,2"/>
        <Setter Property="Panel.ZIndex" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ResizeGrip">
                    <Grid Width="18" Height="18" Background="Transparent" SnapsToDevicePixels="True">
                        <Path Data="M 5,15 L 15,5 M 9,15 L 15,9 M 13,15 L 15,13"
                              Stroke="{DynamicResource AccentForegroundBrush}"
                              StrokeThickness="1.25"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Opacity="0.8"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeResizableWindowHeaderTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LargeResizableWindowCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource StandardButtonGeometryStyle}">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="CaptionGlyph"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CaptionGlyph" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CaptionGlyph" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CaptionGlyph" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:LargeResizableWindowHeader}">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="dialog:DialogWindowBehavior.IsDragRegion" Value="True"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:LargeResizableWindowHeader}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding TitleAreaWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding TitleContent}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding CenterContent}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <ContentPresenter Grid.Column="2"
                                              Content="{TemplateBinding HeaderActions}"
                                              Margin="0,0,6,0"
                                              VerticalAlignment="Center"
                                              shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="PART_MinimizeButton"
                                        Content="&#xE921;"
                                        Style="{StaticResource LargeResizableWindowCaptionButtonStyle}"
                                        AutomationProperties.Name="{services:LocalizedText Key=AutomationMinimizeWindow}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

                                <Button x:Name="PART_MaximizeRestoreButton"
                                        AutomationProperties.Name="{services:LocalizedText Key=AutomationMaximizeRestoreWindow}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource LargeResizableWindowCaptionButtonStyle}">
                                            <Setter Property="Content" Value="&#xE922;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="Maximized">
                                                    <Setter Property="Content" Value="&#xE923;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button x:Name="PART_CloseButton"
                                        Content="&#xE8BB;"
                                        Style="{StaticResource LargeResizableWindowCaptionButtonStyle}"
                                        AutomationProperties.Name="{services:LocalizedText Key=AutomationCloseWindow}"
                                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowMinimize" Value="False">
                            <Setter TargetName="PART_MinimizeButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ShowMaximizeRestore" Value="False">
                            <Setter TargetName="PART_MaximizeRestoreButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ShowClose" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LargeResizableWindowStyle" TargetType="{x:Type Window}">
        <Setter Property="dialog:WorkAreaMaximizeBehavior.IsEnabled" Value="True"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResizeWithGrip"/>
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="46"
                                    ResizeBorderThickness="7"
                                    CornerRadius="8"
                                    GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <Border x:Name="LargeResizableWindowShell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <AdornerDecorator>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                            </AdornerDecorator>
                            <ResizeGrip x:Name="LargeResizableWindowResizeGrip"
                                        Style="{StaticResource LargeResizableWindowResizeGripStyle}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="LargeResizableWindowShell" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="LargeResizableWindowResizeGrip" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="LargeResizableWindowResizeGrip" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="LargeResizableWindowResizeGrip" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Match the height of the system caption and frame in device-independent units. -->
    <Style x:Key="MainWindowStyle" TargetType="{x:Type Window}"
           BasedOn="{StaticResource LargeResizableWindowStyle}">
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="{x:Static controls:LargeResizableWindowHeader.SystemCaptionHeight}"
                                    ResizeBorderThickness="{x:Static controls:LargeResizableWindowHeader.MainResizeBorderThickness}" CornerRadius="8"
                                    GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <!-- The shared WorkAreaMaximizeBehavior now places the whole HWND inside rcWork.
             The former maximized resize-frame padding would inset the client a second time. -->
    </Style>
</ResourceDictionary>
