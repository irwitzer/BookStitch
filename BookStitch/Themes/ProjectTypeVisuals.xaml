<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:services="clr-namespace:BookStitch.Services">

    <!-- Central project-type visuals. Keep PNG assets and monochrome glyphs reusable across dialogs. -->
    <BitmapImage x:Key="ProjectTypeAudioDiscImageSource"
                 UriSource="/BookStitch;component/Assets/Icons/ProjectTypes/ProjectType_AudioCd.png"/>
    <BitmapImage x:Key="ProjectTypeMp3DiscImageSource"
                 UriSource="/BookStitch;component/Assets/Icons/ProjectTypes/ProjectType_Mp3Disc.png"/>
    <BitmapImage x:Key="ProjectTypeFolderImageSource"
                 UriSource="/BookStitch;component/Assets/Icons/ProjectTypes/ProjectType_Folder.png"/>
    <BitmapImage x:Key="ProjectTypeMp3ImageSource"
                 UriSource="/BookStitch;component/Assets/Icons/ProjectTypes/ProjectType_Mp3.png"/>
    <BitmapImage x:Key="ProjectTypeAudioImageSource"
                 UriSource="/BookStitch;component/Assets/Icons/ProjectTypes/ProjectType_Audio.png"/>

    <Style x:Key="ProjectTypePngImageStyle" TargetType="Image">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <DataTemplate x:Key="ProjectTypeFolderIconTemplate">
        <Image Source="{StaticResource ProjectTypeFolderImageSource}"
               Style="{StaticResource ProjectTypePngImageStyle}"
               Margin="0,0,8,0"
               AutomationProperties.Name="{services:LocalizedText Key=AutomationFolderProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeMp3DiscIconTemplate">
        <Image Source="{StaticResource ProjectTypeMp3DiscImageSource}"
               Style="{StaticResource ProjectTypePngImageStyle}"
               Margin="0,0,8,0"
               AutomationProperties.Name="{services:LocalizedText Key=AutomationMp3CdProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeAudioDiscIconTemplate">
        <Image Source="{StaticResource ProjectTypeAudioDiscImageSource}"
               Style="{StaticResource ProjectTypePngImageStyle}"
               Margin="0,0,8,0"
               AutomationProperties.Name="{services:LocalizedText Key=AutomationAudioCdProject}"/>
    </DataTemplate>

    <!-- Resume-project summary variants use the simpler new MP3/audio symbols.
         The original disc PNG resources above remain available centrally. -->
    <DataTemplate x:Key="ProjectTypeMp3SummaryIconTemplate">
        <Image Source="{StaticResource ProjectTypeMp3ImageSource}"
               Style="{StaticResource ProjectTypePngImageStyle}"
               Margin="0,0,8,0"
               AutomationProperties.Name="{services:LocalizedText Key=AutomationMp3Project}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeAudioSummaryIconTemplate">
        <Image Source="{StaticResource ProjectTypeAudioImageSource}"
               Style="{StaticResource ProjectTypePngImageStyle}"
               Margin="0,0,8,0"
               AutomationProperties.Name="{services:LocalizedText Key=AutomationAudioProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeIconTemplate">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{x:Null}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectType}" Value="FolderProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeFolderIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3DiscProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeMp3SummaryIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3Disc">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeMp3SummaryIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="AudioCdProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeAudioSummaryIconTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

    <!-- Monochrome project-type glyph family. Foreground is tied to the normal text color system. -->
    <Style x:Key="ProjectTypeGlyphTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="ProjectTypeFolderGlyphTemplate">
        <TextBlock Text="&#x1F5C1;"
                   Style="{StaticResource ProjectTypeGlyphTextStyle}"
                   AutomationProperties.Name="{services:LocalizedText Key=AutomationFolderProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeMp3DiscGlyphTemplate">
        <TextBlock Text="&#x229B;"
                   Style="{StaticResource ProjectTypeGlyphTextStyle}"
                   AutomationProperties.Name="{services:LocalizedText Key=AutomationMp3CdProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeAudioDiscGlyphTemplate">
        <TextBlock Text="&#x266C;"
                   Style="{StaticResource ProjectTypeGlyphTextStyle}"
                   AutomationProperties.Name="{services:LocalizedText Key=AutomationAudioCdProject}"/>
    </DataTemplate>

    <DataTemplate x:Key="ProjectTypeGlyphTemplate">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{x:Null}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectType}" Value="FolderProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeFolderGlyphTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3DiscProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeMp3DiscGlyphTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3Disc">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeMp3DiscGlyphTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="AudioCdProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource ProjectTypeAudioDiscGlyphTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

    <!-- Reusable list/drop-down representation: name/date | type glyph | status. -->
    <DataTemplate x:Key="ProjectTypeListItemTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding ListDisplayPrefix}"
                       Foreground="{DynamicResource MainTextBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text=" | "
                       Foreground="{DynamicResource MainTextBrush}"
                       VerticalAlignment="Center"/>
            <ContentControl Content="{Binding}"
                            ContentTemplate="{StaticResource ProjectTypeGlyphTemplate}"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"/>
            <TextBlock Text=" | "
                       Foreground="{DynamicResource MainTextBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ListDisplayState}"
                       Foreground="{DynamicResource MainTextBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
