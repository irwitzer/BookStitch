<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BookStitch.Controls">

    <!-- Canonical form start shared with the metadata output-folder settings. -->
    <Thickness x:Key="SettingsFormMargin">110,0,0,8</Thickness>

    <!-- Shared decorative language PNG; retain the existing control sizes and accessibility semantics. -->
    <DataTemplate x:Key="LanguageSymbolTemplate">
        <Image
               Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Focusable="False" IsHitTestVisible="False">
            <Image.Source>
                <BitmapImage UriSource="/BookStitch;component/Assets/Icons/BookStitch-Language-Petrol.png"
                             CacheOption="OnLoad" CreateOptions="IgnoreImageCache"/>
            </Image.Source>
        </Image>
    </DataTemplate>

    <Style x:Key="NavigationDialogListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="NavigationDialogItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavigationItemBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavigationDialogNavigationHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="12,16,12,12"/>
    </Style>

    <Style x:Key="NavigationDialogContentHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="NavigationDialogContextHostStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style TargetType="{x:Type controls:LargeResizableWindowFooter}">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
    </Style>
    <Style x:Key="ConceptNavigationSectionSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,0,8,8"/>
        <Setter Property="Background" Value="{DynamicResource PanelBorderBrush}"/>
        <Setter Property="Opacity" Value="0.72"/>
    </Style>
</ResourceDictionary>
