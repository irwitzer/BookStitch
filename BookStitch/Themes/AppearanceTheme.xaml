<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:controls="clr-namespace:BookStitch.Controls"
                    xmlns:services="clr-namespace:BookStitch.Services">
    <!-- Shared geometry for all ordinary buttons; visual styles keep their own colors and widths. -->
    <sys:Double x:Key="StandardButtonHeight">28</sys:Double>
    <sys:Double x:Key="StepperButtonHeight">22</sys:Double>
    <Style x:Key="StandardButtonGeometryStyle" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource StandardButtonHeight}"/>
        <Setter Property="MinHeight" Value="{DynamicResource StandardButtonHeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource StandardButtonGeometryStyle}"/>

    <BitmapImage x:Key="InfoSquareImageSource" UriSource="/BookStitch;component/Assets/Faq/BookMachin Press.png"/>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#061719"/>

    <!-- DriveCircle follows the existing theme-aware petrol/accent button palette. -->
    <Style x:Key="DriveCircleSlotBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,4"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsDriveEnabled, RelativeSource={RelativeSource AncestorType={x:Type controls:DriveCircleSlot}}}" Value="False">
                <Setter Property="Background" Value="{DynamicResource SecondaryButtonBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryButtonBorderBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsConnected, RelativeSource={RelativeSource AncestorType={x:Type controls:DriveCircleSlot}}}" Value="False">
                <Setter Property="Opacity" Value="0.66"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonHoverBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonHoverBorderBrush}"/>
            </Trigger>
            <DataTrigger Binding="{Binding IsPointerPressed, RelativeSource={RelativeSource AncestorType={x:Type controls:DriveCircleSlot}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimaryButtonPressedBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonPressedBorderBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDragged, RelativeSource={RelativeSource AncestorType={x:Type controls:DriveCircleSlot}}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DragBadgeBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource DragBadgeBorderBrush}"/>
                <Setter Property="Opacity" Value="1"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#112D30"/>
    <SolidColorBrush x:Key="ProjectSetupCardBackgroundBrush" Color="#061719"/>
    <CornerRadius x:Key="AppearanceTextBoxCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="AppearanceComboBoxCornerRadius">7</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">9</CornerRadius>
    <CornerRadius x:Key="SettingsButtonCornerRadius">8</CornerRadius>
    <Thickness x:Key="SettingsButtonPadding">10,3</Thickness>

    <ControlTemplate x:Key="SettingsButtonTemplate" TargetType="Button">
        <Border x:Name="ButtonBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource SettingsButtonCornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="ContentPresenter"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ContentPresenter" Property="Opacity" Value="0.82"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#2C3640"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0E272A"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#35414D"/>
    <SolidColorBrush x:Key="MainTextBrush" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9EABB8"/>
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#D6C4A4"/>
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="DragBadgeBackgroundBrush" Color="#234F6B"/>
    <SolidColorBrush x:Key="DragBadgeBorderBrush" Color="#6EA9D1"/>

    <!-- Button families own their mode-aware colors independently from input/text/neutral surfaces. -->
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#126F73"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBackgroundBrush" Color="#168A8F"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBackgroundBrush" Color="#0F5F63"/>
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="#126F73"/>
    <SolidColorBrush x:Key="PrimaryButtonHoverBorderBrush" Color="#168A8F"/>
    <SolidColorBrush x:Key="PrimaryButtonPressedBorderBrush" Color="#0F5F63"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonBackgroundBrush" Color="#21494C"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonHoverBackgroundBrush" Color="#285A5E"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonPressedBackgroundBrush" Color="#1B3E41"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonBorderBrush" Color="#37676A"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonHoverBorderBrush" Color="#4F8A8D"/>
    <SolidColorBrush x:Key="PrimaryMutedButtonPressedBorderBrush" Color="#315B5E"/>
    <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#1B242A"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBackgroundBrush" Color="#22303A"/>
    <SolidColorBrush x:Key="SecondaryButtonPressedBackgroundBrush" Color="#18262D"/>
    <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="SecondaryButtonBorderBrush" Color="#35414D"/>
    <SolidColorBrush x:Key="SecondaryButtonHoverBorderBrush" Color="#63D4D8"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#126F73"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#168A8F"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#63D4D8"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#63D4D8"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#126F73"/>
    <SolidColorBrush x:Key="ChoiceItemHighlightBackgroundBrush" Color="#126F73"/>
    <SolidColorBrush x:Key="ChoiceItemHighlightForegroundBrush" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="NeutralHoverBackgroundBrush" Color="#22303A"/>
    <SolidColorBrush x:Key="NeutralPressedBackgroundBrush" Color="#18262D"/>
    <SolidColorBrush x:Key="DisabledButtonBackgroundBrush" Color="#1B242A"/>
    <SolidColorBrush x:Key="DisabledButtonBorderBrush" Color="#2F3C44"/>
    <SolidColorBrush x:Key="DisabledButtonTextBrush" Color="#6F8088"/>
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#557B80"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6A969B"/>
    <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#3F5F63"/>
    <SolidColorBrush x:Key="GridLineBrush" Color="#27313A"/>

    <!-- Central, theme-driven information affordance. Runtime appearance settings replace these semantic brushes. -->
    <SolidColorBrush x:Key="InfoIconBorderBrush" Color="#5F88A8"/>
    <SolidColorBrush x:Key="InfoIconGlyphBrush" Color="#B8D3E6"/>
    <SolidColorBrush x:Key="InfoIconHoverBorderBrush" Color="#7BA8C8"/>
    <SolidColorBrush x:Key="InfoIconHoverGlyphBrush" Color="#D9ECF7"/>
    <SolidColorBrush x:Key="InfoOnPrimaryIconBorderBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="InfoOnPrimaryIconGlyphBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="InfoOnPrimaryIconHoverBorderBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoOnPrimaryIconHoverGlyphBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InfoPopupBackgroundBrush" Color="#061719"/>
    <SolidColorBrush x:Key="InfoPopupBorderBrush" Color="#35414D"/>
    <SolidColorBrush x:Key="InfoPopupForegroundBrush" Color="#FFF7E8"/>

    <!-- Central destructive/error semantic family. Colors are mode-aware and independent from normal text presets. -->
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#B95C67"/>
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#7A2630"/>
    <SolidColorBrush x:Key="DangerHoverBackgroundBrush" Color="#96313D"/>
    <SolidColorBrush x:Key="DangerHoverBorderBrush" Color="#E07A85"/>
    <SolidColorBrush x:Key="DangerPressedBackgroundBrush" Color="#652029"/>
    <SolidColorBrush x:Key="DangerPressedBorderBrush" Color="#C95F6B"/>
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7070"/>
    <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#2D1414"/>
    <SolidColorBrush x:Key="DuplicateWarningBackgroundBrush" Color="#6B3F46"/>

    <SolidColorBrush x:Key="QuietDangerTextBrush" Color="#D58B91"/>
    <SolidColorBrush x:Key="QuietDangerBorderBrush" Color="#7B3D45"/>
    <SolidColorBrush x:Key="QuietDangerBackgroundBrush" Color="#211719"/>
    <SolidColorBrush x:Key="QuietDangerHoverBackgroundBrush" Color="#2C1A1D"/>
    <SolidColorBrush x:Key="QuietDangerHoverBorderBrush" Color="#A3545D"/>
    <SolidColorBrush x:Key="QuietDangerHoverTextBrush" Color="#E3A0A6"/>
    <SolidColorBrush x:Key="QuietDangerPressedBackgroundBrush" Color="#351C20"/>

    <SolidColorBrush x:Key="BlockingWarningRowBackgroundBrush" Color="#211719"/>
    <SolidColorBrush x:Key="BlockingWarningRowForegroundBrush" Color="#D58B91"/>
    <SolidColorBrush x:Key="BlockingWarningRowBorderBrush" Color="#7B3D45"/>
    <SolidColorBrush x:Key="BlockingWarningRowHoverBackgroundBrush" Color="#2C1A1D"/>
    <SolidColorBrush x:Key="BlockingWarningRowSelectedBackgroundBrush" Color="#351C20"/>
    <SolidColorBrush x:Key="BlockingWarningRowSelectedForegroundBrush" Color="#E3A0A6"/>
    <SolidColorBrush x:Key="BlockingWarningRowSelectedBorderBrush" Color="#A3545D"/>

    <SolidColorBrush x:Key="WarningProgressBackgroundBrush" Color="#241416"/>
    <SolidColorBrush x:Key="WarningProgressForegroundBrush" Color="#D35B62"/>
    <SolidColorBrush x:Key="WarningProgressBorderBrush" Color="#A5444A"/>
    <SolidColorBrush x:Key="WarningProgressTextBrush" Color="#F1C8CB"/>

    <Style x:Key="BookStitchKeyboardFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{DynamicResource AccentSoftBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            SnapsToDevicePixels="True"
                            IsHitTestVisible="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <BitmapImage x:Key="CoverPlaceholderImageSource" UriSource="/BookStitch;component/Assets/Icons/BookStitchLogo-Round.png"/>
    <BitmapImage x:Key="BrandLogoImageSource" UriSource="/BookStitch;component/Assets/Icons/icon/BookStitch-Icon-Feather.ico"/>

    <!-- DEPRECATED: Legacy vector project-type icon family.
         Retained temporarily for reference/rollback only. Active UI uses Themes/ProjectTypeVisuals.xaml. -->
    <DataTemplate x:Key="DeprecatedProjectTypeFolderVectorIconTemplate">
        <Grid Width="28" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBlock Text="&#xE8B7;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="20"
                       Foreground="{DynamicResource AccentForegroundBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeprecatedProjectTypeMp3DiscVectorIconTemplate">
        <Grid Width="28" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
            <Grid>
                <Ellipse Width="21" Height="21" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.4"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.2"/>
                <TextBlock Text="MP3"
                           FontSize="6"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,-2"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeprecatedProjectTypeAudioDiscVectorIconTemplate">
        <Grid Width="28" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
            <Grid>
                <Ellipse Width="21" Height="21" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.4"/>
                <Ellipse Width="5" Height="5" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="1.2"/>
                <TextBlock Text="{x:Static services:UiSymbolResources.ProjectTypeAudioDisc}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,-1,-3"/>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DeprecatedProjectTypeVectorIconTemplate">
        <ContentControl Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate" Value="{x:Null}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectType}" Value="FolderProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource DeprecatedProjectTypeFolderVectorIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3DiscProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource DeprecatedProjectTypeMp3DiscVectorIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="Mp3Disc">
                            <Setter Property="ContentTemplate" Value="{StaticResource DeprecatedProjectTypeMp3DiscVectorIconTemplate}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectType}" Value="AudioCdProject">
                            <Setter Property="ContentTemplate" Value="{StaticResource DeprecatedProjectTypeAudioDiscVectorIconTemplate}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </DataTemplate>

    <!-- Shared read-only brand-logo presentation. The image role is separate from cover semantics. -->
    <Style x:Key="BrandLogoDisplayBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
    </Style>

    <Style x:Key="BrandLogoDisplayImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <services:CoverPickerHintMetricConverter x:Key="CoverPickerHintMetricConverter"/>

    <!-- Shared visual shell for interactive cover pickers. Dimensions remain local to each host. -->
    <Style x:Key="CoverPickerBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style x:Key="CoverPickerImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="UniformToFill"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Opacity" Value="0.95"/>
    </Style>

    <Style x:Key="CoverPickerHintBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="{DynamicResource CoverPickerHintVerticalAlignment}"/>
        <Setter Property="Height">
            <Setter.Value>
                <Binding Path="ActualWidth"
                         RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource CoverPickerHintMetricConverter}"
                         ConverterParameter="BannerHeight"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CoverPickerHintTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="FontSize">
            <Setter.Value>
                <Binding Path="ActualWidth"
                         RelativeSource="{RelativeSource AncestorType={x:Type ContentControl}}"
                         Converter="{StaticResource CoverPickerHintMetricConverter}"
                         ConverterParameter="FontSize"/>
            </Setter.Value>
        </Setter>
        <Setter Property="FontWeight" Value="{DynamicResource CoverPickerHintFontWeight}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="CoverPickerHintContentStyle" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource CoverPickerHintMetricConverter}, ConverterParameter=HorizontalMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{services:LocalizedText Key=UiCover}"
                                   HorizontalAlignment="Left"
                                   Style="{StaticResource CoverPickerHintTextStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{services:LocalizedText Key=UiWaehlen}"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CoverPickerHintTextStyle}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared read-only cover display used where the cover is shown without picker interaction. -->
    <Style x:Key="CoverDisplayBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
    </Style>

    <Style x:Key="CoverDisplayImageStyle" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
    </Style>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#126F73"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#126F73"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF7E8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF7E8"/>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
    </Style>

    <!-- Central tooltip infrastructure. Product controls opt in explicitly via localized keys. -->
    <Style x:Key="BookStitchToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="Placement" Value="Mouse"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="12"
                                          RecognizesAccessKey="True"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip" BasedOn="{StaticResource BookStitchToolTipStyle}"/>

    <Style x:Key="AppearanceTextBoxStyle" TargetType="TextBox">
        <Setter Property="ContextMenu" Value="{DynamicResource BookStitchTextEditContextMenu}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBoxBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource AppearanceTextBoxCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource DisabledButtonTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DisabledButtonBorderBrush}"/>
                            <Setter Property="Opacity" Value="0.72"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox"
           BasedOn="{StaticResource AppearanceTextBoxStyle}"/>

    <Style x:Key="AppearanceCompactTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource AppearanceTextBoxStyle}">
        <Style.Resources>
            <CornerRadius x:Key="AppearanceTextBoxCornerRadius">8</CornerRadius>
        </Style.Resources>
        <Setter Property="Height" Value="27"/>
        <Setter Property="MinHeight" Value="27"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarTrackBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppearanceScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbDraggingBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBarTrackBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ScrollBarTrackBrush}"/>
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AppearanceScrollBarThumbStyle}" Margin="3"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppearanceRoundedScrollBarStyle"
           TargetType="ScrollBar"
           BasedOn="{StaticResource {x:Type ScrollBar}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border x:Name="RoundedTrackBackground"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0"
                            CornerRadius="7">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Background="Transparent"
                                              BorderBrush="Transparent"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource AppearanceScrollBarThumbStyle}" Margin="3"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Background="Transparent"
                                              BorderBrush="Transparent"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="Height" Value="14"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="Width" Value="14"/>
                            <Setter Property="Height" Value="Auto"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="True"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogInsetScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="16,16,14,16"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="AppearanceFadeHeaderStyle" TargetType="{x:Type controls:FadeHeader}">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
        <Setter Property="HeaderHeight" Value="32"/>
        <Setter Property="FadeHeight" Value="24"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FadeHeader}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding HeaderHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <RowDefinition Height="{Binding FadeHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>

                        <Border x:Name="FadeSurface"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Black" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="0.35"/>
                                    <GradientStop Color="#55000000" Offset="0.72"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBackground"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource ChoiceItemHighlightBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ChoiceItemHighlightForegroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                            <Setter Property="Opacity" Value="0.48"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Experimental chapter mode follows the same access state as the developer wrench. -->
    <Style x:Key="ChapterModeComboBoxItemStyle" TargetType="ComboBoxItem"
           BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                               Value="{x:Static services:ChapterSettingsService.ModeChapterMaster}"/>
                    <Condition Binding="{Binding IsEnabled, Source={x:Static services:DeveloperToolsCommands.AccessState}}"
                               Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="IsEnabled" Value="False"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The combo owns disabled colors/opacity; its editor must not apply the
         standalone TextBox disabled treatment a second time. -->
    <ControlTemplate x:Key="ComboBoxEditableTextTemplate" TargetType="TextBox">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
    </ControlTemplate>

    <Style x:Key="AppearanceComboBoxStyle" TargetType="ComboBox">
        <Style.Resources>
            <Thickness x:Key="AppearanceComboBoxContentMargin">7,2,28,2</Thickness>
            <Thickness x:Key="AppearanceComboBoxEditableTextMargin">7,1,28,1</Thickness>
        </Style.Resources>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Foreground" Value="{DynamicResource MainTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="ComboBoxChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppearanceComboBoxCornerRadius}"
                                SnapsToDevicePixels="True"/>

                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid Background="{TemplateBinding Background}">
                                        <Path x:Name="DropDownArrow"
                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource MutedTextBrush}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,9,0"/>
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{DynamicResource AppearanceComboBoxContentMargin}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left">
                            <ContentPresenter.Resources>
                                <!-- Generated selection text must follow the combo's palette/state,
                                     rather than the global TextBlock active-text default. -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground"
                                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>

                        <TextBox x:Name="PART_EditableTextBox"
                                 Style="{x:Null}"
                                 Template="{StaticResource ComboBoxEditableTextTemplate}"
                                 Visibility="Hidden"
                                 ContextMenu="{DynamicResource BookStitchTextEditContextMenu}"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource MainTextBrush}"
                                 BorderThickness="0"
                                 Padding="0"
                                 Margin="{DynamicResource AppearanceComboBoxEditableTextMargin}"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Stretch"
                                 Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.72"/>
                            <Setter Property="Background" Value="{DynamicResource DisabledButtonBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DisabledButtonBorderBrush}"/>
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Foreground" Value="{DynamicResource DisabledButtonTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppearanceCompactComboBoxStyle"
